---
import Icon from "./Icon.astro";
---

<theme-toggle>
    <button>
        <span class="sr-only">Dark theme</span>
        <span class="icon light"><Icon icon="sun" /></span>
        <span class="icon dark"><Icon icon="moon-stars" /></span>
    </button>
</theme-toggle>

<style>
    button {
        display: flex;
        border: 0;
        border-radius: 999rem;
        padding: 0;
        background-color: var(--gray-999);
        box-shadow: inset 0 0 0 1px var(--accent-overlay);
        cursor: pointer;
    }

    .icon {
        z-index: 1;
        position: relative;
        display: flex;
        padding: 0.5rem;
        width: 2rem;
        height: 2rem;
        font-size: 1rem;
        color: var(--accent-overlay);
    }

    .icon.light::before {
        content: "";
        z-index: -1;
        position: absolute;
        inset: 0;
        background-color: var(--accent-regular);
        border-radius: 999rem;
    }

    :global(.theme-dark) .icon.light::before {
        transform: translateX(100%);
    }

    :global(.theme-dark) .icon.dark,
    :global(html:not(.theme-dark)) .icon.light,
    button[aria-pressed="false"] .icon.light {
        color: var(--accent-text-over);
        filter: brightness(1.35);
    }

    @media (prefers-reduced-motion: no-preference) {
        .icon,
        .icon.light::before {
            transition:
                transform var(--theme-transition),
                color var(--theme-transition);
        }
    }

    @media (forced-colors: active) {
        .icon.light::before {
            background-color: SelectedItem;
        }
    }
</style>

<script>
    class ThemeToggle extends HTMLElement {
        constructor() {
            super();

            const button = this.querySelector("button")!;

            const applyThemeState = (dark: boolean, source: "user" | "os") => {
                document.documentElement.classList.toggle("theme-dark", dark);
                document.documentElement.classList.toggle("theme-light", !dark);
                document.documentElement.dataset.theme = dark
                    ? "dark"
                    : "light";
                document.documentElement.dataset.themeSource = source;
                button.setAttribute("aria-pressed", String(dark));
            };

            /** Set the theme to dark/light mode. */
            const setTheme = (dark: boolean) => {
                const selectedTheme = dark ? "dark" : "light";
                const osTheme = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches
                    ? "dark"
                    : "light";
                const isOsOverride = selectedTheme !== osTheme;
                applyThemeState(dark, isOsOverride ? "user" : "os");
                if (typeof localStorage !== "undefined") {
                    localStorage.setItem("theme", selectedTheme);
                    if (isOsOverride) {
                        localStorage.setItem("theme-user", "1");
                        localStorage.setItem(
                            "theme-user-at",
                            String(Date.now()),
                        );
                        localStorage.setItem("theme-os-at-set", osTheme);
                    } else {
                        localStorage.removeItem("theme-user");
                        localStorage.removeItem("theme-user-at");
                        localStorage.removeItem("theme-os-at-set");
                    }
                }
            };

            // Toggle the theme when a user clicks the button.
            button.addEventListener("click", () => setTheme(!this.isDark()));

            const mediaQuery = window.matchMedia(
                "(prefers-color-scheme: dark)",
            );
            const syncWithOsTheme = (
                e: MediaQueryList | MediaQueryListEvent,
            ) => {
                applyThemeState(e.matches, "os");
                if (typeof localStorage !== "undefined") {
                    localStorage.setItem("theme", e.matches ? "dark" : "light");
                    localStorage.removeItem("theme-user");
                    localStorage.removeItem("theme-user-at");
                    localStorage.removeItem("theme-os-at-set");
                }
            };
            mediaQuery.addEventListener("change", syncWithOsTheme);

            // Initialize button state to reflect current theme.
            const source =
                document.documentElement.dataset.themeSource === "user"
                    ? "user"
                    : "os";
            applyThemeState(this.isDark(), source);
        }

        isDark() {
            return document.documentElement.classList.contains("theme-dark");
        }
    }
    if (!customElements.get("theme-toggle")) {
        customElements.define("theme-toggle", ThemeToggle);
    }
</script>
