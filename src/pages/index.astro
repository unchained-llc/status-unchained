---
import { visibleCheckTokens, visibleSystems } from '../status-config';
type Check={token:string;url:string;alias?:string;enabled:boolean;published:boolean;down:boolean;uptime:number;last_check_at:string;displayName?:string;periodUptime?:number;history?:{date:string;hadDowntime:boolean}[]};
type Downtime={started_at:string;ended_at:string|null};
const apiKey='ro-REDACTED';
const names=new Map<string,string>(visibleSystems.map(({token,name})=>[token,name]));
const days=Array.from({length:7},(_,i)=>{const d=new Date();d.setUTCHours(0,0,0,0);d.setUTCDate(d.getUTCDate()-(6-i));return d});
const sevenDaysAgo=new Date(Date.now()-7*24*60*60*1000);const periodUptime=async(token:string)=>{try{const url=`https://updown.io/api/checks/${token}/metrics?api-key=${apiKey}&from=${encodeURIComponent(sevenDaysAgo.toISOString())}&to=${encodeURIComponent(new Date().toISOString())}`;const r=await fetch(url);if(!r.ok)return NaN;const metrics=await r.json() as {uptime:number};return Number(metrics.uptime)}catch{return NaN}};const history=async(token:string)=>{try{const r=await fetch(`https://updown.io/api/checks/${token}/downtimes?api-key=${apiKey}`);const ds=await r.json() as Downtime[];return days.map(date=>{const end=new Date(date);end.setUTCDate(end.getUTCDate()+1);return{date:date.toISOString(),hadDowntime:ds.some(x=>new Date(x.started_at)<end&&new Date(x.ended_at??Date.now())>=date)}})}catch{return days.map(date=>({date:date.toISOString(),hadDowntime:false}))}};
let checks:Check[]=[];let failed=false;
try{const r=await fetch(`https://updown.io/api/checks?api-key=${apiKey}`);const data=await r.json() as Check[];const order=new Map<string,number>(visibleCheckTokens.map((t,i)=>[t,i]));checks=(await Promise.all(data.filter(c=>c.published&&order.has(c.token)).map(async c=>({...c,displayName:names.get(c.token)??c.url,periodUptime:await periodUptime(c.token),history:await history(c.token)})))).sort((a,b)=>(order.get(a.token)??0)-(order.get(b.token)??0))}catch{failed=true}
const incident=checks.some(c=>c.down);const maintenance=checks.some(c=>!c.enabled);const now=new Date();const fmt=(n:number)=>Number.isFinite(n)?`${n.toFixed(n===100?0:2)}%`:'—';const dateFmt=(s:string)=>new Intl.DateTimeFormat('en',{month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(s));
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="color-scheme" content="light dark"/><meta name="description" content="UNCHAINEDが提供するサービスの稼働状況"/><title>UNCHAINED | Service Status</title><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260202"/><link rel="icon" type="image/png" href="/favicon.png?v=20260202"/><link rel="stylesheet" href="/global.css"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@100;200;300;400;500;600&display=swap" rel="stylesheet"/></head><body><div class="page-shell"><header class="site-header"><a href="https://www.unchained.co.jp" class="brand" aria-label="UNCHAINED公式サイト"><img src="/assets/logo.svg" alt="" width="48" height="48"/><span>UNCHAINED</span></a></header><main class="status-page" data-api-key={apiKey} data-visible-tokens={visibleCheckTokens.join(',')}><header class="page-heading"><p class="kicker">STATUS</p><h1 class="bilingual-title"><span class="en">Service Status</span><span class="ja">サービス稼働状況</span></h1></header><section class:list={['status-overview',failed?'is-error':incident?'has-incident':maintenance?'is-maintenance':'is-operational']} aria-live="polite"><span class="overview-dot"></span><div><p class="overview-primary">{failed?'Status unavailable':incident?'Service disruption detected':maintenance?'Scheduled maintenance':'All systems operational'}</p><p class="overview-secondary">{failed?'稼働状況を取得できませんでした':incident?'一部のサービスで障害が発生しています':maintenance?'一部のサービスはメンテナンス中です':'すべてのサービスは正常に稼働しています'}</p></div><time class="last-updated" datetime={now.toISOString()}>Live status</time></section><section class="services">{checks.map(c=><article class:list={['service-row',c.down?'is-down':!c.enabled?'is-maintenance':'is-up']} data-token={c.token}><div class="service-identity"><span class="service-dot"></span><div><h2>{c.displayName}</h2><p>Last checked <time datetime={c.last_check_at}>{c.last_check_at}</time></p><div class="history">{c.history?.map(d=><span class:list={['history-day',d.hadDowntime&&'had-downtime']} title={`${d.date.slice(0,10)}: ${d.hadDowntime?'Downtime recorded':'Operational'}`}></span>)}</div>{c.history&&<div class="history-labels"><span>{dateFmt(c.history[0].date)}</span><span>Today</span></div>}</div></div><div class="service-result"><span class="status-label">{c.down?'Disruption':!c.enabled?'Maintenance':'Operational'}</span><span class="uptime"><small>7-DAY UPTIME</small>{fmt(Number(c.periodUptime))}</span><a href={`https://updown.io/${c.token}`} target="_blank" rel="noreferrer">↗</a></div></article>)}{checks.length===0&&<div class="empty-state">現在公開中のサービス情報はありません</div>}</section><p class="status-note">Status monitoring by <a href="https://updown.io" target="_blank" rel="noreferrer">updown.io ↗</a></p></main><footer><p>&copy; {now.getFullYear()} UNCHAINED</p></footer></div><script>
type Check={token:string;enabled:boolean;published:boolean;down:boolean;uptime:number;last_check_at:string};const page=document.querySelector<HTMLElement>('.status-page');const rel=(v:string|Date)=>{const d=v instanceof Date?v:new Date(v),s=Math.round((d.getTime()-Date.now())/1e3),f=new Intl.RelativeTimeFormat('en',{numeric:'auto'}),u:Array<[Intl.RelativeTimeFormatUnit,number]>=[['year',31536000],['month',2592000],['day',86400],['hour',3600],['minute',60],['second',1]],[unit,n]=u.find(([,n])=>Math.abs(s)>=n)??u.at(-1)!;return f.format(Math.round(s/n),unit)};document.querySelectorAll<HTMLTimeElement>('.service-identity time').forEach(t=>t.textContent=rel(t.dateTime));(async()=>{if(!page)return;try{const r=await fetch(`https://updown.io/api/checks?api-key=${encodeURIComponent(page.dataset.apiKey??'')}`),data=await r.json() as Check[],visible=new Set((page.dataset.visibleTokens??'').split(',')),checks=data.filter(c=>c.published&&visible.has(c.token)),down=checks.some(c=>c.down),maintenance=checks.some(c=>!c.enabled),overview=document.querySelector<HTMLElement>('.status-overview')!,primary=document.querySelector<HTMLElement>('.overview-primary')!,secondary=document.querySelector<HTMLElement>('.overview-secondary')!;overview.classList.remove('is-operational','has-incident','is-maintenance','is-error');overview.classList.add(down?'has-incident':maintenance?'is-maintenance':'is-operational');primary.textContent=down?'Service disruption detected':maintenance?'Scheduled maintenance':'All systems operational';secondary.textContent=down?'一部のサービスで障害が発生しています':maintenance?'一部のサービスはメンテナンス中です':'すべてのサービスは正常に稼働しています';const from=new Date(Date.now()-7*24*60*60*1000).toISOString();const periodChecks=await Promise.all(checks.map(async c=>{try{const metricsResponse=await fetch(`https://updown.io/api/checks/${c.token}/metrics?api-key=${encodeURIComponent(page.dataset.apiKey??'')}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(new Date().toISOString())}`);const metrics=await metricsResponse.json() as {uptime:number};return{...c,uptime:Number(metrics.uptime)}}catch{return{...c,uptime:NaN}}}));periodChecks.forEach(c=>{const row=document.querySelector<HTMLElement>(`[data-token="${c.token}"]`);if(!row)return;row.classList.toggle('is-down',c.down);row.classList.toggle('is-maintenance',!c.enabled);row.classList.toggle('is-up',!c.down&&c.enabled);row.querySelector<HTMLElement>('.status-label')!.textContent=c.down?'Disruption':!c.enabled?'Maintenance':'Operational';const up=row.querySelector<HTMLElement>('.uptime')!,n=Number(c.uptime);up.lastChild!.textContent=Number.isFinite(n)?`${n.toFixed(n===100?0:2)}%`:'—';const t=row.querySelector<HTMLTimeElement>('time')!;t.dateTime=c.last_check_at;t.textContent=rel(c.last_check_at)});const updated=document.querySelector<HTMLTimeElement>('.last-updated')!;updated.dateTime=new Date().toISOString();updated.textContent=`Updated ${rel(new Date())}`}catch(e){console.error(e)}})();
</script></body></html>
