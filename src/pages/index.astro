      }

      const syncNowInCard=()=>{if(!activeWrap)return;const card=activeWrap.querySelector<HTMLElement>('.history-card');if(!card||card.hidden)return;const rail=card.querySelector<HTMLElement>('.history-dayline-rail.is-today');if(!rail)return;const nowPct=currentClockPct();const now=rail.querySelector<HTMLElement>('.history-dayline-now');if(now)now.style.left=`${nowPct}%`;if(rail.classList.contains('is-today')){const pct=dayTimelineProgressPct(localYmd(new Date()));rail.style.setProperty('--now-pct',`${pct}%`);const progress=rail.querySelector<HTMLElement>('.history-dayline-progress');if(progress)progress.style.width=`${pct}%`}}

      const openFromButton=(btn:HTMLButtonElement,locked:boolean)=>{const wrap=btn.closest<HTMLElement>('.history-wrap');if(!wrap)return;const raw=btn.dataset.dayPayload;if(!raw)return;let payload:DayPayload;try{payload=JSON.parse(decodeURIComponent(raw)) as DayPayload}catch{return}renderCard(wrap,btn,payload,locked);syncNowInCard();if(!nowTicker)nowTicker=window.setInterval(syncNowInCard,1000)}

      const attachHistoryCard=(wrap:HTMLElement)=>{
        if(wrap.dataset.cardBound==='true')return

        const pickButton=(target:EventTarget|null)=>{
          if(!(target instanceof Element))return null
          const btn=target.closest<HTMLButtonElement>('.history-day')
          return btn&&wrap.contains(btn)?btn:null
        }

        wrap.addEventListener('mouseover',(event)=>{
          if(isMobileView())return
          const btn=pickButton(event.target)
          if(!btn)return
          if(activeBtn===btn&&activeWrap===wrap)return
          openFromButton(btn,false)
        })

        wrap.addEventListener('mousemove',(event)=>{
          if(isMobileView())return
          const btn=pickButton(event.target)
          if(!btn)return
          if(activeBtn!==btn||activeWrap!==wrap)openFromButton(btn,false)
        })

        wrap.addEventListener('focusin',(event)=>{
          if(lockOpen)return
          const btn=pickButton(event.target)
          if(!btn)return
          openFromButton(btn,false)
        })

        wrap.addEventListener('click',(event)=>{
          const btn=pickButton(event.target)
          if(!btn)return
          event.preventDefault()
          if(activeBtn===btn&&lockOpen){closeActiveCard();return}
          openFromButton(btn,true)
        })

        wrap.addEventListener('keydown',(event)=>{
          const btn=pickButton(event.target)
          if(!btn)return
          if(event.key==='Enter'||event.key===' '){
            event.preventDefault()
            if(activeBtn===btn&&lockOpen){closeActiveCard();return}
            openFromButton(btn,true)
          }
        })

        wrap.dataset.cardBound='true'
      }

      document.addEventListener('click',(event)=>{const target=event.target as Node;if(activeWrap&& !activeWrap.contains(target))closeActiveCard();if(activeBadge&&!activeBadge.closest<HTMLElement>('.status-with-badge')?.contains(target))closeEventBadgePopover()})
      document.addEventListener('keydown',(event)=>{if(event.key==='Escape'){closeActiveCard();closeEventBadgePopover()}})
      window.addEventListener('resize',()=>{if(activeWrap&&activeBtn){const card=activeWrap.querySelector<HTMLElement>('.history-card');if(card&&!card.hidden)positionCard(activeWrap,activeBtn,card)}if(activeBadge){const host=activeBadge.closest<HTMLElement>('.status-with-badge');const pop=host?.querySelector<HTMLElement>('.history-event-popover');if(pop&&!pop.hidden)positionEventBadgePopover(activeBadge,pop)}})
      window.addEventListener('scroll',()=>{if(activeWrap&&activeBtn){const card=activeWrap.querySelector<HTMLElement>('.history-card');if(card&&!card.hidden)positionCard(activeWrap,activeBtn,card)}if(activeBadge){const host=activeBadge.closest<HTMLElement>('.status-with-badge');const pop=host?.querySelector<HTMLElement>('.history-event-popover');if(pop&&!pop.hidden)positionEventBadgePopover(activeBadge,pop)}},{passive:true})

      const createRow=(check:Check)=>{const row=document.createElement('article');row.className='service-row';row.dataset.token=check.token;row.style.setProperty('--today-led-delay',`${ledPhaseMs(check.token)}ms`);row.style.setProperty('--today-led-duration',`${ledDurationMs(check.token)}ms`);row.innerHTML=`<div class="service-identity"><span class="service-dot"></span><div><div class="service-headline"><h2></h2></div><div class="history-wrap" data-token="${check.token}"><div class="history" role="list" aria-label="7-day history"></div><div class="history-labels"><span></span><span>Today</span></div><div class="history-card" id="history-card-${check.token}" role="dialog" aria-live="polite" hidden></div></div><p class="service-meta">Last checked <time></time></p></div></div><div class="service-result"><div class="status-with-badge"><span class="status-label"></span><button type="button" class="history-event-badge" hidden aria-label="Event count" aria-expanded="false"><span class="history-event-badge-dot" aria-hidden="true"></span><span class="history-event-badge-count"></span></button></div><span class="uptime"><small>7-DAY UPTIME</small>—</span><a target="_blank" rel="noreferrer">↗</a></div>`;row.querySelector<HTMLAnchorElement>('.service-result a')!.href=`https://updown.io/${check.token}`;attachHistoryCard(row.querySelector<HTMLElement>('.history-wrap')!);attachEventBadgePopover(row);return row}

      const renderHistoryDays=(row:HTMLElement,check:Check,days:Array<{date:string;downtimeSeconds:number;partial:boolean;utcWindows:string[]}>)=>{const history=row.querySelector<HTMLElement>('.history')!;const wrap=row.querySelector<HTMLElement>('.history-wrap')!;let totalEvents=0;const summaryDays:BadgeSummaryDay[]=[];const buttons=days.map(day=>{const dateStr=day.date.slice(0,10);const events=normalizeEventsForDay(check.token,dateStr,{downtimeSeconds:day.downtimeSeconds,partial:day.partial,utcWindows:day.utcWindows});const marker=markerFromEvents(events);const count=events.length;totalEvents+=count;if(count>0)summaryDays.push({date:dateStr,events});const btn=document.createElement('button');btn.type='button';btn.className=`history-day${day.downtimeSeconds>0?' had-downtime':''}${marker!=='operational'?' has-event':''} marker-${marker}`;btn.dataset.dayPayload=encodeURIComponent(JSON.stringify({date:dateStr,marker,count,events} satisfies DayPayload));btn.setAttribute('aria-label',`${dateStr} history${count?`, ${count} ${count===1?'event':'events'}`:''}`);btn.setAttribute('aria-expanded','false');btn.setAttribute('aria-controls',`history-card-${check.token}`);btn.innerHTML=`<span class="history-led" aria-hidden="true"></span><span class="history-marker" aria-hidden="true"></span>`;return btn});history.replaceChildren(...buttons);const badge=row.querySelector<HTMLButtonElement>('.service-result .history-event-badge');if(badge){if(activeBadge===badge)closeEventBadgePopover(badge);badge.setAttribute('aria-expanded','false');const badgeCount=badge.querySelector<HTMLElement>('.history-event-badge-count');badge.hidden=false;if(totalEvents>0){badge.classList.remove('is-empty');badge.disabled=false;if(badgeCount)badgeCount.textContent=String(totalEvents);badge.setAttribute('aria-label',`${totalEvents} ${totalEvents===1?'event':'events'} in the last 7 days`);badge.dataset.eventsSummary=encodeURIComponent(JSON.stringify(summaryDays))}else{badge.classList.add('is-empty');badge.disabled=true;if(badgeCount)badgeCount.textContent='0';badge.removeAttribute('aria-label');delete badge.dataset.eventsSummary}}if(days.length>0){row.querySelector<HTMLElement>('.history-labels span')!.textContent=new Intl.DateTimeFormat(undefined,{month:'short',day:'numeric'}).format(new Date(days[0].date))}attachHistoryCard(wrap);attachEventBadgePopover(row)}

      const updateHistory=async(row:HTMLElement,check:Check)=>{try{if(Array.isArray(check.history)&&check.history.length===7){renderHistoryDays(row,check,check.history);return}const response=await fetch(`/api/checks/${encodeURIComponent(check.token)}/downtimes`);const downtimes=await response.json() as Downtime[];const dates=Array.from({length:7},(_,index)=>{const date=new Date();date.setUTCHours(0,0,0,0);date.setUTCDate(date.getUTCDate()-(6-index));return date});const days=dates.map(date=>{const end=new Date(date);end.setUTCDate(end.getUTCDate()+1);const {totalSeconds,partial,utcWindows}=resolveDowntimeForDay(downtimes,date,end);return{date:dayKey(date),downtimeSeconds:totalSeconds,partial,utcWindows}});renderHistoryDays(row,check,days)}catch{}}

      const hasOngoingMaintenance=(token:string)=>{const list=eventsByToken[token]??[];let ongoing=false;for(const event of list){if(event.type==='maintenance_started')ongoing=true;else if(event.type==='maintenance_ended')ongoing=false}return ongoing}
      const resolveLiveStatus=(check:Check)=>{const down=Boolean(check.down);const maintenance=!down&&(!check.enabled||hasOngoingMaintenance(check.token));return{down,maintenance,up:!down&&!maintenance,label:down?'Disruption':maintenance?'Maintenance':'Operational'}}

      const checkSignature=(check:Check)=>JSON.stringify({
        alias:check.alias?.trim()||`Check ${check.token}`,
        enabled:check.enabled,
        down:check.down,
        last_check_at:check.last_check_at,
        periodUptime:Number.isFinite(Number(check.periodUptime))?Number(check.periodUptime):null,
        history:Array.isArray(check.history)?check.history:null,
      })

      const updateRow=async(check:Check)=>{if(!services)return;let row=document.querySelector<HTMLElement>(`[data-token="${check.token}"]`);if(!row)row=createRow(check);const live=resolveLiveStatus(check);row.style.setProperty('--today-led-delay',`${ledPhaseMs(check.token)}ms`);row.style.setProperty('--today-led-duration',`${ledDurationMs(check.token)}ms`);row.dataset.category=check.category??'uncategorized';row.classList.toggle('is-down',live.down);row.classList.toggle('is-maintenance',live.maintenance);row.classList.toggle('is-up',live.up);row.querySelector<HTMLElement>('.service-identity h2')!.textContent=(check.displayName??check.alias?.trim())||`Check ${check.token}`;row.querySelector<HTMLElement>('.status-label')!.textContent=live.label;const time=row.querySelector<HTMLTimeElement>('.service-identity time')!;time.dateTime=check.last_check_at;time.textContent=rel(check.last_check_at);if(Number.isFinite(Number(check.periodUptime))){row.querySelector<HTMLElement>('.uptime')!.lastChild!.textContent=formatUptime(Number(check.periodUptime))}else{try{const from=new Date(Date.now()-7*24*60*60*1000).toISOString();const to=new Date().toISOString();const response=await fetch(`/api/checks/${encodeURIComponent(check.token)}/metrics?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`);const metrics=await response.json() as {uptime:number};row.querySelector<HTMLElement>('.uptime')!.lastChild!.textContent=formatUptime(Number(metrics.uptime))}catch{row.querySelector<HTMLElement>('.uptime')!.lastChild!.textContent='—'}}attachEventBadgePopover(row);await updateHistory(row,check);if(!row.isConnected)services.append(row);row.dataset.signature=checkSignature(check)}

      const renderCategorySections=(checks:Check[])=>{if(!services)return;const grouped=new Map<string,Check[]>();checks.forEach(check=>{const key=check.category??'uncategorized';const list=grouped.get(key)??[];list.push(check);grouped.set(key,list)});const categoryKeys=[...grouped.keys()].sort((a,b)=>{const rank=(value:string)=>{const idx=CATEGORY_ORDER.indexOf(value as (typeof CATEGORY_ORDER)[number]);return idx===-1?CATEGORY_ORDER.length:idx};const rankDiff=rank(a)-rank(b);return rankDiff!==0?rankDiff:a.localeCompare(b,'en')});const activeSet=new Set(categoryKeys);services.querySelectorAll<HTMLElement>('.services-category').forEach(section=>{const key=section.dataset.category??'';if(!activeSet.has(key))section.remove()});categoryKeys.forEach(category=>{const categoryChecks=grouped.get(category)??[];let section=services.querySelector<HTMLElement>(`.services-category[data-category="${category}"]`);if(!section){section=document.createElement('section');section.className='services-category';section.dataset.category=category;section.innerHTML='<h3 class="services-category-title"></h3><div class="services-category-list"></div>'}const title=section.querySelector<HTMLElement>('.services-category-title');if(title)title.textContent=categoryLabel(category);const list=section.querySelector<HTMLElement>('.services-category-list');if(list){const rows=categoryChecks.map(check=>document.querySelector<HTMLElement>(`[data-token="${check.token}"]`)).filter((row):row is HTMLElement=>Boolean(row));list.replaceChildren(...rows)}services.append(section)})}

      const refreshRelativeTimes=()=>{
        document.querySelectorAll<HTMLTimeElement>('.service-identity time').forEach(time=>{
          if(time.dateTime)time.textContent=rel(time.dateTime)
        })
      }

      refreshRelativeTimes()
      if(!relativeTimeTicker)relativeTimeTicker=window.setInterval(refreshRelativeTimes,1000)

      document.querySelectorAll<HTMLElement>('.history-wrap').forEach(attachHistoryCard)

      const POLL_INTERVAL_MS=60000
      let refreshInFlight=false

      const refreshStatus=async()=>{
        if(!page||!services||refreshInFlight)return
        refreshInFlight=true
        try{
          const eventsState=await loadEvents()
          const eventsGeneratedAt=eventsState?.generatedAt??null
          const eventsChanged=typeof eventsGeneratedAt==='string'&&eventsGeneratedAt!==eventsVersionKey
          if(typeof eventsGeneratedAt==='string')eventsVersionKey=eventsGeneratedAt
          const syncedAt=eventsState?.generatedAt??null
          setEventsFreshness(syncedAt)

          const response=await fetch('/api/checks',{cache:'no-store'})
          const data=await response.json() as Check[]
          const checks=sortChecksForDisplay(
            [...data]
              .filter(check=>check.published!==false)
              .map(check=>{
                const naming=parseCheckNaming(check)
                return {...check,category:naming.category,displayName:naming.displayName}
              })
          )

          services.classList.add('is-refreshing')
          services.setAttribute('aria-busy','true')

          const tokens=new Set(checks.map(check=>check.token))
          services.querySelectorAll<HTMLElement>('.service-row').forEach(row=>{
            if(!tokens.has(row.dataset.token??''))row.remove()
          })

          if(checks.length===0){
            closeActiveCard()
            services.querySelectorAll<HTMLElement>('.empty-state').forEach(node=>node.remove())
            services.querySelectorAll<HTMLElement>('.services-category').forEach(node=>node.remove())
            const empty=document.createElement('div')
            empty.className='empty-state'
            empty.textContent='No public service status information is currently available'
            services.append(empty)
          }else{
            services.querySelectorAll<HTMLElement>('.empty-state').forEach(node=>node.remove())
            let changed=false
            await Promise.all(checks.map(async check=>{
              const row=document.querySelector<HTMLElement>(`[data-token="${check.token}"]`)
              const nextSignature=checkSignature(check)
              const currentSignature=row?.dataset.signature
              if(!row||currentSignature!==nextSignature||eventsChanged){
                changed=true
                await updateRow(check)
              }
            }))

            renderCategorySections(checks)

            if(changed)closeActiveCard()
          }

          services.classList.remove('is-initializing','is-refreshing')
          services.removeAttribute('aria-busy')

          const liveStates=checks.map(check=>resolveLiveStatus(check))
          const disruptionCount=liveStates.filter(state=>state.down).length
          const maintenanceCount=liveStates.filter(state=>state.maintenance).length
          const operationalCount=liveStates.filter(state=>state.up).length
          const down=disruptionCount>0
          const countText=disruptionCount||maintenanceCount
            ? [`${operationalCount} Operational`,disruptionCount&&`${disruptionCount} Disruption`,maintenanceCount&&`${maintenanceCount} Maintenance`].filter(Boolean).join(' · ')
            : `${operationalCount} / ${checks.length} Operational`

          document.querySelector<HTMLElement>('.status-count')!.textContent=countText

          const maintenance=maintenanceCount>0
          const overview=document.querySelector<HTMLElement>('.status-overview')!
          overview.classList.remove('is-checking','is-operational','has-incident','is-maintenance','is-error')
          overview.classList.add(down?'has-incident':maintenance?'is-maintenance':'is-operational')
          document.querySelector<HTMLElement>('.overview-primary')!.textContent=down?'Service disruption detected':maintenance?'Scheduled maintenance':'All systems operational'
          document.querySelector<HTMLElement>('.overview-secondary')!.textContent=down?'Some services are currently experiencing disruptions':maintenance?'Some services are currently under maintenance':'All services are operating normally'
        }catch(error){
          console.error(error)
          services.classList.remove('is-initializing','is-refreshing')
          services.removeAttribute('aria-busy')
          setEventsFreshness(null)
          const overview=document.querySelector<HTMLElement>('.status-overview')
          overview?.classList.remove('is-checking')
          overview?.classList.add('is-error')
          document.querySelector<HTMLElement>('.overview-primary')!.textContent='Status unavailable'
          document.querySelector<HTMLElement>('.overview-secondary')!.textContent='Failed to retrieve service status'
          document.querySelector<HTMLElement>('.status-count')!.textContent='Unable to update'
        }finally{
          refreshInFlight=false
        }
      }

      void refreshStatus()
      window.setInterval(()=>{void refreshStatus()},POLL_INTERVAL_MS)
      document.addEventListener('visibilitychange',()=>{
        if(document.visibilityState==='visible')void refreshStatus()
      })
    </script>
  </body>
</html>
