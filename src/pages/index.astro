        </header>

        <section class="status-overview is-checking" aria-live="polite">
          <span class="overview-dot"></span>
          <div>
            <p class="overview-primary">Checking systems</p>
            <p class="overview-secondary">Checking current system status</p>
          </div>
          <div class="overview-meta">
            <span class="status-count">Checking current status</span>
            <span class="events-freshness" hidden>Last update unavailable</span>
          </div>
        </section>

        <section class="services is-initializing" aria-busy="true">
          {checks.map((c) => (
            <article class:list={['service-row', c.down ? 'is-down' : !c.enabled ? 'is-maintenance' : 'is-up']} data-token={c.token} style={`--today-led-delay:${ledPhaseMs(c.token)}ms;--today-led-duration:${ledDurationMs(c.token)}ms;`}>
              <div class="service-identity">
                <span class="service-dot"></span>
                <div>
                  <div class="service-headline">
                    <h2>{c.displayName}</h2>
                  </div>
                  {c.history && (
                    <div class="history-wrap" data-token={c.token}>
                      <div class="history" role="list" aria-label="7-day history">
                        {c.history.map((d) => {
                          const date = d.date.slice(0, 10)
                          const events = eventsForDay(c.token, date, d)
                          const marker = markerFromEvents(events)
                          const count = events.length
                          const payload = encodeURIComponent(JSON.stringify({ date, marker, count, events } satisfies DayPayload))
                          return (
                            <button
                              type="button"
                              class:list={[
                                'history-day',
                                d.hadDowntime && 'had-downtime',
                                marker !== 'operational' && 'has-event',
                                `marker-${marker}`,
                              ]}
                              data-day-payload={payload}
                              aria-label={`${date} history${count > 0 ? `, ${count} events` : ''}`}
                              aria-expanded="false"
                              aria-controls={`history-card-${c.token}`}
                            >
                              <span class="history-led" aria-hidden="true"></span>
                              <span class="history-marker" aria-hidden="true"></span>
                            </button>
                          )
                        })}
                      </div>
                      <div class="history-labels">
                        <span>{dateFmt(c.history[0].date)}</span>
                        <span>Today</span>
                      </div>
                      <div class="history-card" id={`history-card-${c.token}`} role="dialog" aria-live="polite" hidden></div>
                    </div>
                  )}
                  <p class="service-meta">Last checked <time datetime={c.last_check_at}>{c.last_check_at}</time></p>
                </div>
              </div>
              <div class="service-result">
                <div class="status-with-badge">
                  <span class="status-label">{c.down ? 'Disruption' : !c.enabled ? 'Maintenance' : 'Operational'}</span>
                  <button type="button" class="history-event-badge" hidden aria-label="Event count" aria-expanded="false"><span class="history-event-badge-dot" aria-hidden="true"></span><span class="history-event-badge-count"></span></button>
                </div>
                <span class="uptime"><small>7-DAY UPTIME</small>{fmt(Number(c.periodUptime))}</span>
                <a href={`https://updown.io/${c.token}`} target="_blank" rel="noreferrer">↗</a>
              </div>
            </article>
          ))}


        </section>

        <p class="status-note">Status monitoring by <a href="https://updown.io" target="_blank" rel="noreferrer">updown.io ↗</a></p>

      </main>

      <footer><p>&copy; {now.getFullYear()} UNCHAINED</p></footer>
    </div>

    <script>
      type DayHistory={date:string;hadDowntime:boolean;downtimeSeconds:number;partial:boolean;utcWindows:string[]}
      type Check={token:string;url?:string;type?:string;alias?:string;enabled:boolean;published?:boolean;down:boolean;uptime:number;last_check_at:string;periodUptime?:number;history?:DayHistory[];category?:string;displayName?:string}
      type Downtime={started_at:string;ended_at:string|null;duration?:number;partial?:boolean}
      type StatusEventType='maintenance_started'|'maintenance_ended'|'incident_started'|'incident_resolved'|'state_changed'
      type StatusEvent={token:string;alias:string;from:string;to:string;type:StatusEventType;at:string}
      type MarkerStatus='operational'|'maintenance'|'degraded'|'outage'
      type NormalizedEvent={id:string;serviceId:string;date:string;startAt?:string;endAt?:string;status:'maintenance'|'degraded'|'outage';title:string;description?:string;ongoing:boolean}
      type DayPayload={date:string;marker:MarkerStatus;count:number;events:NormalizedEvent[]}
      type BadgeSummaryDay={date:string;events:NormalizedEvent[]}
      type EventsResponse={generated_at?:string|null;checked_at?:string|null;events?:StatusEvent[]}

      const page=document.querySelector<HTMLElement>('.status-page')
      const services=document.querySelector<HTMLElement>('.services')
      const eventsFreshness=document.querySelector<HTMLElement>('.events-freshness')
      const notifyToggle=document.querySelector<HTMLButtonElement>('.notify-toggle')
      const notifyToggleLabel=document.querySelector<HTMLElement>('.notify-toggle-label')
      const eventsByToken:Record<string,StatusEvent[]>={}
      const EVENTS_DELAY_MS=3*60*1000
      const NOTIFY_PREF_KEY='status-notify-enabled'
      const isMobileView=()=>{const touchOnly=window.matchMedia('(hover: none) and (pointer: coarse)').matches;const hasHoverCapablePointer=window.matchMedia('(any-hover: hover) and (any-pointer: fine)').matches;return touchOnly&&!hasHoverCapablePointer}

      const rel=(value:string|Date)=>{const date=value instanceof Date?value:new Date(value);const seconds=Math.round((date.getTime()-Date.now())/1000);const formatter=new Intl.RelativeTimeFormat('en',{numeric:'auto'});const units:Array<[Intl.RelativeTimeFormatUnit,number]>=[['year',31536000],['month',2592000],['day',86400],['hour',3600],['minute',60],['second',1]];const [unit,amount]=units.find(([,amount])=>Math.abs(seconds)>=amount)??units.at(-1)!;return formatter.format(Math.round(seconds/amount),unit)}
      const formatUptime=(value:number)=>Number.isFinite(value)?`${value.toFixed(value===100?0:2)}%`:'—'
      const dayKey=(value:Date|string)=>new Date(value).toISOString().slice(0,10)
      const hhmm=(value:string)=>{const d=new Date(value);return`${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`}
      const formatUtcDateTime=(ms:number)=>{const iso=new Date(ms).toISOString().replace(/\.\d{3}Z$/,'Z');return`${iso.slice(0,10)} ${iso.slice(11)} UTC`}
      const parseDateOnlyLocal=(value:string)=>{const m=value.match(/^(\d{4})-(\d{2})-(\d{2})$/);if(!m)return null;const y=Number(m[1]);const mo=Number(m[2]);const d=Number(m[3]);if(!Number.isFinite(y)||!Number.isFinite(mo)||!Number.isFinite(d))return null;return new Date(y,mo-1,d,12,0,0,0)}
      const asLocalDate=(value:Date|string)=>{if(value instanceof Date)return value;return parseDateOnlyLocal(value)??new Date(value)}
      const localYmd=(value:Date|string)=>{const d=asLocalDate(value);return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
      const localDateLabel=(value:Date|string)=>new Intl.DateTimeFormat(undefined,{dateStyle:'medium'}).format(asLocalDate(value))
      const localTzName=(value:Date|string)=>{const d=asLocalDate(value);const part=new Intl.DateTimeFormat(undefined,{timeZoneName:'short'}).formatToParts(d).find((p)=>p.type==='timeZoneName');return part?.value??''}
      const statusFromDowntime=(seconds:number):'degraded'|'outage'=>seconds>=900?'outage':'degraded'
      const ledHash=(token:string)=>{let hash=0;for(const ch of token)hash=(hash*33+ch.charCodeAt(0))>>>0;return hash};const ledPhaseMs=(token:string)=>-(ledHash(token)%1200);const ledDurationMs=(token:string)=>180+(ledHash(token)%121)
      const CATEGORY_ORDER=['foundation','network','communication','identity','platform','operations','uncategorized'] as const
      const NETWORK_DISPLAY_ORDER=['Security Gateway','IPv6 Connectivity','IPv4 Connectivity','5G Cellular Redundancy','Private Mesh Network','Time Synchronization']
      const networkDisplayName=(name:string)=>name.replace(/^IPv([46]) Internet Connectivity$/,'IPv$1 Connectivity')
      const FOUNDATION_DISPLAY_ORDER=['Compute Fabric #1','Compute Fabric #2','Storage Fabric','Facility Automation']
      const aliasCategoryPattern=/\*([a-z0-9_-]+)\s*$/i

      const normalizeCategory=(raw:string)=>{const normalized=raw.trim().toLowerCase().replace(/[^a-z0-9_-]+/g,'');if(!normalized)return'uncategorized';if(['core','foundation','fabric','facility'].includes(normalized))return'foundation';if(['net','network'].includes(normalized))return'network';if(['mail','voice','comms','communication'].includes(normalized))return'communication';if(['id','identity','auth','trust','directory','certificate'].includes(normalized))return'identity';if(['dev','platform','pipeline','repo','repository','web'].includes(normalized))return'platform';if(['ops','operation','operations','monitoring','security','vuln','backup','dr','disasterrecovery'].includes(normalized))return'operations';return normalized}
      const categoryLabel=(category:string)=>{if(category==='foundation')return'Foundation';if(category==='network')return'Networking';if(category==='communication')return'Communications';if(category==='operations')return'Operations';return category.replace(/[_-]+/g,' ').replace(/\b[a-z]/g,(ch)=>ch.toUpperCase())}
      const inferCategoryWithoutTag=(check:Check,alias:string)=>{const text=alias.toLowerCase();if(/\b(core network|network core|ipv4|ipv6|5g|cellular|mesh|time synchronization|network continuity|network availability|private mesh|router|opnsense|ntp)\b/.test(text))return'network';if(/\b(core|storage|fabric|facility)\b/.test(text))return'foundation';if(/\b(mail|dns|mx|smtp|imap|pop|voice|telecommunications|pbx)\b/.test(text))return'communication';if(/\b(identity|auth|authentication|directory|certificate|ca|keycloak|activedirectory)\b/.test(text))return'identity';if(/\b(collaboration|development|pipeline|repository|gitlab|runner|web presence|corporate web)\b/.test(text))return'platform';if(/\b(monitoring|data protection|disaster recovery|vulnerability|nessus|bareos|operations)\b/.test(text))return'operations';if(check.type==='pulse')return'network';return'uncategorized'}
      const parseCheckNaming=(check:Check)=>{const alias=(check.alias??'').trim();const fallback=`Check ${check.token}`;if(!alias)return{category:inferCategoryWithoutTag(check,''),displayName:fallback};const match=alias.match(aliasCategoryPattern);if(!match)return{category:inferCategoryWithoutTag(check,alias),displayName:alias};const category=normalizeCategory(match[1]);const displayName=alias.replace(aliasCategoryPattern,'').trim()||fallback;return{category,displayName}}
      const sortChecksForDisplay=(checks:Check[])=>[...checks].sort((a,b)=>{const orderA=CATEGORY_ORDER.indexOf((a.category as (typeof CATEGORY_ORDER)[number])??'uncategorized');const orderB=CATEGORY_ORDER.indexOf((b.category as (typeof CATEGORY_ORDER)[number])??'uncategorized');const rankA=orderA===-1?CATEGORY_ORDER.length:orderA;const rankB=orderB===-1?CATEGORY_ORDER.length:orderB;if(rankA!==rankB)return rankA-rankB;const categoryA=a.category??'uncategorized';const categoryB=b.category??'uncategorized';if(categoryA!==categoryB)return categoryA.localeCompare(categoryB,'en');const nameA=(a.displayName??a.alias?.trim()??`Check ${a.token}`);const nameB=(b.displayName??b.alias?.trim()??`Check ${b.token}`);if(categoryA==='network'){const networkA=NETWORK_DISPLAY_ORDER.indexOf(networkDisplayName(nameA));const networkB=NETWORK_DISPLAY_ORDER.indexOf(networkDisplayName(nameB));const networkRankA=networkA===-1?NETWORK_DISPLAY_ORDER.length:networkA;const networkRankB=networkB===-1?NETWORK_DISPLAY_ORDER.length:networkB;if(networkRankA!==networkRankB)return networkRankA-networkRankB}if(categoryA==='foundation'){const foundationA=FOUNDATION_DISPLAY_ORDER.indexOf(nameA);const foundationB=FOUNDATION_DISPLAY_ORDER.indexOf(nameB);const foundationRankA=foundationA===-1?FOUNDATION_DISPLAY_ORDER.length:foundationA;const foundationRankB=foundationB===-1?FOUNDATION_DISPLAY_ORDER.length:foundationB;if(foundationRankA!==foundationRankB)return foundationRankA-foundationRankB}const coreA=/^core\b/i.test(nameA)?0:1;const coreB=/^core\b/i.test(nameB)?0:1;if(coreA!==coreB)return coreA-coreB;return nameA.localeCompare(nameB,'en')})

      const loadEvents=async()=>{try{const response=await fetch('/api/events.json',{cache:'no-store'});if(!response.ok)return null;Object.keys(eventsByToken).forEach(key=>delete eventsByToken[key]);const json=await response.json() as EventsResponse;(json.events??[]).forEach(event=>{if(!event||typeof event.token!=='string'||typeof event.at!=='string')return;if(!eventsByToken[event.token])eventsByToken[event.token]=[];eventsByToken[event.token].push(event)});Object.values(eventsByToken).forEach(list=>list.sort((a,b)=>new Date(a.at).getTime()-new Date(b.at).getTime()));return{generatedAt:typeof json.generated_at==='string'?json.generated_at:null}}catch{return null}}

      const resolveDowntimeForDay=(downtimes:Downtime[],dayStart:Date,dayEnd:Date)=>{let totalSeconds=0;let partial=false;const utcWindows:string[]=[];for(const d of downtimes){const start=new Date(d.started_at).getTime();const end=new Date(d.ended_at??Date.now()).getTime();const overlapStart=Math.max(start,dayStart.getTime());const overlapEnd=Math.min(end,dayEnd.getTime());if(overlapEnd>overlapStart){totalSeconds+=Math.round((overlapEnd-overlapStart)/1000);partial=partial||Boolean(d.partial);utcWindows.push(`${formatUtcDateTime(overlapStart)} → ${formatUtcDateTime(overlapEnd)}`)}}return{totalSeconds,partial,utcWindows}}

