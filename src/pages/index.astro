---
import eventsDoc from '../../public/events.json'

type Check = {
  token: string
  url: string
  alias?: string
  enabled: boolean
  published: boolean
  down: boolean
  uptime: number
  last_check_at: string
  displayName?: string
  periodUptime?: number
  history?: { date: string; hadDowntime: boolean; downtimeSeconds: number; partial: boolean; utcWindows: string[] }[]
}

type Downtime = { started_at: string; ended_at: string | null; duration?: number; partial?: boolean }
type StatusEventType =
  | 'maintenance_started'
  | 'maintenance_ended'
  | 'incident_started'
  | 'incident_resolved'
  | 'state_changed'

type StatusEvent = {
  token: string
  alias: string
  from: string
  to: string
  type: StatusEventType
  at: string
}

const apiKey = 'ro-REDACTED'

const days = Array.from({ length: 7 }, (_, i) => {
  const d = new Date()
  d.setUTCHours(0, 0, 0, 0)
  d.setUTCDate(d.getUTCDate() - (6 - i))
  return d
})

const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000)

const periodUptime = async (token: string) => {
  try {
    const url = `https://updown.io/api/checks/${token}/metrics?api-key=${apiKey}&from=${encodeURIComponent(sevenDaysAgo.toISOString())}&to=${encodeURIComponent(new Date().toISOString())}`
    const r = await fetch(url)
    if (!r.ok) return NaN
    const metrics = (await r.json()) as { uptime: number }
    return Number(metrics.uptime)
  } catch {
    return NaN
  }
}

const formatUtcDateTime = (ms: number) => {
  const iso = new Date(ms).toISOString().replace(/\.\d{3}Z$/, 'Z')
  return `${iso.slice(0, 10)} ${iso.slice(11)} UTC`
}

const resolveDowntimeForDay = (downtimes: Downtime[], dayStart: Date, dayEnd: Date) => {
  let totalSeconds = 0
  let partial = false
  const utcWindows: string[] = []
  for (const d of downtimes) {
    const start = new Date(d.started_at).getTime()
    const end = new Date(d.ended_at ?? Date.now()).getTime()
    const overlapStart = Math.max(start, dayStart.getTime())
    const overlapEnd = Math.min(end, dayEnd.getTime())
    if (overlapEnd > overlapStart) {
      totalSeconds += Math.round((overlapEnd - overlapStart) / 1000)
      partial = partial || Boolean(d.partial)
      utcWindows.push(`${formatUtcDateTime(overlapStart)} → ${formatUtcDateTime(overlapEnd)}`)
    }
  }
  return { totalSeconds, partial, utcWindows }
}

const formatDowntime = (seconds: number) => {
  const safe = Math.max(0, Math.round(seconds))
  const h = Math.floor(safe / 3600)
  const m = Math.floor((safe % 3600) / 60)
  const s = safe % 60
  if (h > 0) return `${h}h ${m}m ${s}s downtime`
  if (m > 0) return `${m}m ${s}s downtime`
  return `${s}s downtime`
}

const history = async (token: string) => {
  try {
    const r = await fetch(`https://updown.io/api/checks/${token}/downtimes?api-key=${apiKey}`)
    const ds = (await r.json()) as Downtime[]
    return days.map((date) => {
      const end = new Date(date)
      end.setUTCDate(end.getUTCDate() + 1)
      const { totalSeconds, partial, utcWindows } = resolveDowntimeForDay(ds, date, end)
      return {
        date: date.toISOString(),
        hadDowntime: totalSeconds > 0,
        downtimeSeconds: totalSeconds,
        partial,
        utcWindows,
      }
    })
  } catch {
    return days.map((date) => ({ date: date.toISOString(), hadDowntime: false, downtimeSeconds: 0, partial: false, utcWindows: [] }))
  }
}

let checks: Check[] = []
try {
  const response = await fetch(`https://updown.io/api/checks?api-key=${apiKey}`)
  const data = (await response.json()) as Check[]
  const sorted = [...data].sort((a, b) =>
    (a.alias?.trim() || `Check ${a.token}`).localeCompare(b.alias?.trim() || `Check ${b.token}`, 'en'),
  )
  checks = await Promise.all(
    sorted.map(async (c) => ({
      ...c,
      displayName: c.alias?.trim() || `Check ${c.token}`,
      periodUptime: await periodUptime(c.token),
      history: await history(c.token),
    })),
  )
} catch {
  checks = []
}

const eventLabel = (type: StatusEventType) =>
  type === 'incident_started'
    ? 'Incident started'
    : type === 'incident_resolved'
      ? 'Incident resolved'
      : 'State changed'

const dayKey = (value: Date | string) => new Date(value).toISOString().slice(0, 10)
const eventsByToken: Record<string, StatusEvent[]> = {}

try {
  const parsed = eventsDoc as { events?: StatusEvent[] }
  ;(parsed.events ?? []).forEach((event) => {
    if (!event || typeof event.token !== 'string' || typeof event.at !== 'string') return
    if (!eventsByToken[event.token]) eventsByToken[event.token] = []
    eventsByToken[event.token].push(event)
  })
  Object.values(eventsByToken).forEach((list) => list.sort((a, b) => new Date(b.at).getTime() - new Date(a.at).getTime()))
} catch {}

const eventTextForDate = (token: string, date: Date | string) => {
  const events = (eventsByToken[token] ?? []).filter((event) => dayKey(event.at) === dayKey(date))
  if (events.length === 0) return ''
  const asc = [...events].sort((a, b) => new Date(a.at).getTime() - new Date(b.at).getTime())

  const maintenanceWindows: string[] = []
  let maintenanceStart: string | null = null
  for (const event of asc) {
    if (event.type === 'maintenance_started') {
      if (maintenanceStart) maintenanceWindows.push(`${formatUtcDateTime(new Date(maintenanceStart).getTime())} → ongoing UTC`)
      maintenanceStart = event.at
      continue
    }
    if (event.type === 'maintenance_ended') {
      if (maintenanceStart) {
        maintenanceWindows.push(`${formatUtcDateTime(new Date(maintenanceStart).getTime())} → ${formatUtcDateTime(new Date(event.at).getTime())}`)
        maintenanceStart = null
      } else {
        maintenanceWindows.push(`ended at ${formatUtcDateTime(new Date(event.at).getTime())}`)
      }
    }
  }
  if (maintenanceStart) maintenanceWindows.push(`${formatUtcDateTime(new Date(maintenanceStart).getTime())} → ongoing UTC`)

  const incidentText = asc
    .filter((event) => event.type === 'incident_started' || event.type === 'incident_resolved')
    .slice(0, 2)
    .map((event) => `${new Date(event.at).toISOString().slice(11, 16)} UTC ${eventLabel(event.type)}`)
    .join(' / ')

  const parts = [
    maintenanceWindows.length > 0 ? `maintenance ${maintenanceWindows.slice(0, 2).join(' / ')}` : '',
    incidentText,
  ].filter(Boolean)

  return parts.join(' / ')
}

const now = new Date()
const fmt = (n: number) => (Number.isFinite(n) ? `${n.toFixed(n === 100 ? 0 : 2)}%` : '—')
const dateFmt = (s: string) => new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(s))
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="UNCHAINEDが提供するサービスの稼働状況" />
    <title>UNCHAINED | System Status</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260202" />
    <link rel="icon" type="image/png" href="/favicon.png?v=20260202" />
    <link rel="stylesheet" href="/global.css?v=20260729" />
    <noscript><style>.services{opacity:1!important}</style></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@100;200;300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a href="https://www.unchained.co.jp" class="brand" aria-label="UNCHAINED公式サイト">
          <img src="/assets/logo.svg" alt="" width="48" height="48" />
          <span>UNCHAINED</span>
        </a>
      </header>

      <main class="status-page" data-api-key={apiKey}>
        <header class="page-heading">
          <p class="kicker">STATUS</p>
          <h1 class="bilingual-title">
            <span class="en">System Status</span>
            <span class="ja">システム稼働状況</span>
          </h1>
        </header>

        <section class="status-overview is-checking" aria-live="polite">
          <span class="overview-dot"></span>
          <div>
            <p class="overview-primary">Checking systems</p>
            <p class="overview-secondary">現在の稼働状況を確認しています</p>
          </div>
          <div class="overview-meta">
            <span class="status-count">Checking current status</span>
            <time class="last-updated" datetime={now.toISOString()}>Live status</time>
          </div>
        </section>

        <section class="services is-initializing" aria-busy="true">
          {checks.map((c) => (
            <article class:list={['service-row', c.down ? 'is-down' : !c.enabled ? 'is-maintenance' : 'is-up']} data-token={c.token}>
              <div class="service-identity">
                <span class="service-dot"></span>
                <div>
                  <h2>{c.displayName}</h2>
                  <p>Last checked <time datetime={c.last_check_at}>{c.last_check_at}</time></p>
                  {c.history && (
                    <div class="history-wrap">
                      <div class="history">
                        {c.history.map((d) => {
                          const eventText = eventTextForDate(c.token, d.date)
                          const windowsText = d.utcWindows.slice(0, 2).join(' / ')
                          const downtimeText = d.hadDowntime
                            ? `${formatDowntime(d.downtimeSeconds)}${windowsText ? ` / ${windowsText}` : ''}${d.partial ? ' (partial data)' : ''}`
                            : 'No downtime recorded on this day'
                          const detailText = d.hadDowntime
                            ? (eventText ? `${downtimeText} / ${eventText}` : downtimeText)
                            : (eventText || downtimeText)
                          const tooltipText = `${d.date.slice(0, 10)}||${detailText}`
                          return (
                            <span
                              class:list={['history-day', d.hadDowntime && 'had-downtime']}
                              data-tooltip={tooltipText}
                              aria-label={`${d.date.slice(0, 10)} ${detailText}`}
                              tabindex="0"
                            ></span>
                          )
                        })}
                      </div>
                      <div class="history-labels">
                        <span>{dateFmt(c.history[0].date)}</span>
                        <span>Today</span>
                      </div>
                      <div class="history-tooltip" hidden></div>
                    </div>
                  )}
                </div>
              </div>
              <div class="service-result">
                <span class="status-label">{c.down ? 'Disruption' : !c.enabled ? 'Maintenance' : 'Operational'}</span>
                <span class="uptime"><small>7-DAY UPTIME</small>{fmt(Number(c.periodUptime))}</span>
                <a href={`https://updown.io/${c.token}`} target="_blank" rel="noreferrer">↗</a>
              </div>
            </article>
          ))}

          {checks.length === 0 && <div class="empty-state">現在公開中のサービス情報はありません</div>}
        </section>

        <p class="status-note">
          Status monitoring by <a href="https://updown.io" target="_blank" rel="noreferrer">updown.io ↗</a>
        </p>
      </main>

      <footer><p>&copy; {now.getFullYear()} UNCHAINED</p></footer>
    </div>

    <script>
      type Check={token:string;alias?:string;enabled:boolean;down:boolean;uptime:number;last_check_at:string};
      type Downtime={started_at:string;ended_at:string|null;duration?:number;partial?:boolean};
      type StatusEventType='maintenance_started'|'maintenance_ended'|'incident_started'|'incident_resolved'|'state_changed';
      type StatusEvent={token:string;alias:string;from:string;to:string;type:StatusEventType;at:string};

      const page=document.querySelector<HTMLElement>('.status-page');
      const services=document.querySelector<HTMLElement>('.services');
      const eventsByToken:Record<string,StatusEvent[]>={};

      const rel=(value:string|Date)=>{const date=value instanceof Date?value:new Date(value);const seconds=Math.round((date.getTime()-Date.now())/1000);const formatter=new Intl.RelativeTimeFormat('en',{numeric:'auto'});const units:Array<[Intl.RelativeTimeFormatUnit,number]>=[['year',31536000],['month',2592000],['day',86400],['hour',3600],['minute',60],['second',1]];const[unit,amount]=units.find(([,amount])=>Math.abs(seconds)>=amount)??units.at(-1)!;return formatter.format(Math.round(seconds/amount),unit)};
      const formatUptime=(value:number)=>Number.isFinite(value)?`${value.toFixed(value===100?0:2)}%`:'—';
      const dayKey=(value:Date|string)=>new Date(value).toISOString().slice(0,10);
      const eventLabel=(type:StatusEventType)=>type==='incident_started'?'Incident started':type==='incident_resolved'?'Incident resolved':'State changed';
      const formatUtcDateTime=(ms:number)=>{const iso=new Date(ms).toISOString().replace(/\.\d{3}Z$/,'Z');return`${iso.slice(0,10)} ${iso.slice(11)} UTC`};
      const resolveDowntimeForDay=(downtimes:Downtime[],dayStart:Date,dayEnd:Date)=>{let totalSeconds=0;let partial=false;const utcWindows:string[]=[];for(const d of downtimes){const start=new Date(d.started_at).getTime();const end=new Date(d.ended_at??Date.now()).getTime();const overlapStart=Math.max(start,dayStart.getTime());const overlapEnd=Math.min(end,dayEnd.getTime());if(overlapEnd>overlapStart){totalSeconds+=Math.round((overlapEnd-overlapStart)/1000);partial=partial||Boolean(d.partial);utcWindows.push(`${formatUtcDateTime(overlapStart)} → ${formatUtcDateTime(overlapEnd)}`)}}return{totalSeconds,partial,utcWindows}};
      const formatDowntime=(seconds:number)=>{const safe=Math.max(0,Math.round(seconds));const h=Math.floor(safe/3600);const m=Math.floor((safe%3600)/60);const s=safe%60;if(h>0)return`${h}h ${m}m ${s}s downtime`;if(m>0)return`${m}m ${s}s downtime`;return`${s}s downtime`};

      const loadEvents=async()=>{try{const response=await fetch('/events.json',{cache:'no-store'});if(!response.ok)return;const json=await response.json() as {events?:StatusEvent[]};const events=(json.events??[]).filter(event=>event&&typeof event.token==='string'&&typeof event.at==='string');events.forEach(event=>{if(!eventsByToken[event.token])eventsByToken[event.token]=[];eventsByToken[event.token].push(event)});Object.values(eventsByToken).forEach(list=>list.sort((a,b)=>new Date(b.at).getTime()-new Date(a.at).getTime()))}catch{}};

      const eventTextForDate=(token:string,date:Date)=>{const events=(eventsByToken[token]??[]).filter(event=>dayKey(event.at)===dayKey(date));if(events.length===0)return'';const asc=[...events].sort((a,b)=>new Date(a.at).getTime()-new Date(b.at).getTime());const maintenanceWindows:string[]=[];let maintenanceStart:string|null=null;for(const event of asc){if(event.type==='maintenance_started'){if(maintenanceStart)maintenanceWindows.push(`${formatUtcDateTime(new Date(maintenanceStart).getTime())} → ongoing UTC`);maintenanceStart=event.at;continue}if(event.type==='maintenance_ended'){if(maintenanceStart){maintenanceWindows.push(`${formatUtcDateTime(new Date(maintenanceStart).getTime())} → ${formatUtcDateTime(new Date(event.at).getTime())}`);maintenanceStart=null}else{maintenanceWindows.push(`ended at ${formatUtcDateTime(new Date(event.at).getTime())}`)}}}if(maintenanceStart)maintenanceWindows.push(`${formatUtcDateTime(new Date(maintenanceStart).getTime())} → ongoing UTC`);const incidentText=asc.filter(event=>event.type==='incident_started'||event.type==='incident_resolved').slice(0,2).map(event=>`${new Date(event.at).toISOString().slice(11,16)} UTC ${eventLabel(event.type)}`).join(' / ');const parts=[maintenanceWindows.length>0?`maintenance ${maintenanceWindows.slice(0,2).join(' / ')}`:'',incidentText].filter(Boolean);return parts.join(' / ')};

      const attachHistoryTooltip=(wrap:HTMLElement|null)=>{if(!wrap||wrap.dataset.tooltipBound==='true')return;const tooltip=wrap.querySelector<HTMLElement>('.history-tooltip');if(!tooltip)return;let activeBar:HTMLElement|null=null;const clamp=(v:number,min:number,max:number)=>Math.min(max,Math.max(min,v));const hide=()=>{tooltip.hidden=true;wrap.classList.remove('has-tooltip');activeBar=null};const show=(bar:HTMLElement)=>{const raw=bar.dataset.tooltip??'';const [dateLabel,detailLabel='']=raw.split('||');tooltip.replaceChildren();const dateEl=document.createElement('p');dateEl.className='history-tooltip-date';dateEl.textContent=dateLabel;const detailEl=document.createElement('p');detailEl.className='history-tooltip-detail';detailEl.textContent=detailLabel;tooltip.append(dateEl,detailEl);tooltip.hidden=false;const wrapRect=wrap.getBoundingClientRect();const barRect=bar.getBoundingClientRect();const centerX=barRect.left-wrapRect.left+barRect.width/2;const tipWidth=tooltip.offsetWidth||280;const maxLeft=Math.max(0,wrapRect.width-tipWidth);const tipLeft=clamp(centerX-tipWidth/2,0,maxLeft);const arrowX=clamp(centerX-tipLeft,12,tipWidth-12);tooltip.style.setProperty('--tip-left',`${tipLeft}px`);tooltip.style.setProperty('--tip-arrow',`${arrowX}px`);wrap.classList.add('has-tooltip');activeBar=bar};const pickBar=(event:Event)=>{const target=(event.target as Element|null)?.closest<HTMLElement>('.history-day');return target&&wrap.contains(target)?target:null};wrap.addEventListener('mouseover',event=>{const target=pickBar(event);if(!target)return;show(target)});wrap.addEventListener('mousemove',event=>{const target=pickBar(event);if(!target)return;if(target!==activeBar)show(target)});wrap.addEventListener('focusin',event=>{const target=pickBar(event);if(!target)return;show(target)});wrap.addEventListener('mouseleave',hide);wrap.addEventListener('focusout',()=>{requestAnimationFrame(()=>{if(!wrap.contains(document.activeElement))hide()})});wrap.addEventListener('click',event=>{const target=pickBar(event);if(!target)return;event.preventDefault();if(activeBar===target){hide();return}show(target)});wrap.dataset.tooltipBound='true'};

      const createRow=(check:Check)=>{const row=document.createElement('article');row.className='service-row';row.dataset.token=check.token;row.innerHTML=`<div class="service-identity"><span class="service-dot"></span><div><h2></h2><p>Last checked <time></time></p><div class="history-wrap"><div class="history"></div><div class="history-labels"><span></span><span>Today</span></div><div class="history-tooltip" hidden></div></div></div></div><div class="service-result"><span class="status-label"></span><span class="uptime"><small>7-DAY UPTIME</small>—</span><a target="_blank" rel="noreferrer">↗</a></div>`;row.querySelector<HTMLAnchorElement>('.service-result a')!.href=`https://updown.io/${check.token}`;attachHistoryTooltip(row.querySelector<HTMLElement>('.history-wrap'));return row};

      const updateHistory=async(row:HTMLElement,check:Check,key:string)=>{try{const response=await fetch(`https://updown.io/api/checks/${check.token}/downtimes?api-key=${key}`);const downtimes=await response.json() as Downtime[];const dates=Array.from({length:7},(_,index)=>{const date=new Date();date.setUTCHours(0,0,0,0);date.setUTCDate(date.getUTCDate()-(6-index));return date});const history=row.querySelector<HTMLElement>('.history')!;history.replaceChildren(...dates.map(date=>{const end=new Date(date);end.setUTCDate(end.getUTCDate()+1);const {totalSeconds,partial,utcWindows}=resolveDowntimeForDay(downtimes,date,end);const hadDowntime=totalSeconds>0;const bar=document.createElement('span');bar.className=`history-day${hadDowntime?' had-downtime':''}`;const eventText=eventTextForDate(check.token,date);const windowsText=utcWindows.slice(0,2).join(' / ');const downtimeText=hadDowntime?`${formatDowntime(totalSeconds)}${windowsText?` / ${windowsText}`:''}${partial?' (partial data)':''}`:'No downtime recorded on this day';const detailText=hadDowntime?(eventText?`${downtimeText} / ${eventText}`:downtimeText):(eventText||downtimeText);bar.dataset.tooltip=`${dayKey(date)}||${detailText}`;bar.setAttribute('aria-label',`${dayKey(date)} ${detailText}`);bar.tabIndex=0;return bar}));row.querySelector<HTMLElement>('.history-labels span')!.textContent=new Intl.DateTimeFormat('en',{month:'short',day:'numeric',timeZone:'UTC'}).format(dates[0]);attachHistoryTooltip(row.querySelector<HTMLElement>('.history-wrap'))}catch{}};

      const updateRow=async(check:Check,key:string)=>{if(!services)return;let row=document.querySelector<HTMLElement>(`[data-token="${check.token}"]`);if(!row)row=createRow(check);services.append(row);row.classList.toggle('is-down',check.down);row.classList.toggle('is-maintenance',!check.enabled);row.classList.toggle('is-up',!check.down&&check.enabled);row.querySelector<HTMLElement>('.service-identity h2')!.textContent=check.alias?.trim()||`Check ${check.token}`;row.querySelector<HTMLElement>('.status-label')!.textContent=check.down?'Disruption':!check.enabled?'Maintenance':'Operational';const time=row.querySelector<HTMLTimeElement>('.service-identity time')!;time.dateTime=check.last_check_at;time.textContent=rel(check.last_check_at);try{const from=new Date(Date.now()-7*24*60*60*1000).toISOString();const response=await fetch(`https://updown.io/api/checks/${check.token}/metrics?api-key=${key}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(new Date().toISOString())}`);const metrics=await response.json() as {uptime:number};row.querySelector<HTMLElement>('.uptime')!.lastChild!.textContent=formatUptime(Number(metrics.uptime))}catch{row.querySelector<HTMLElement>('.uptime')!.lastChild!.textContent='—'}await updateHistory(row,check,key)};

      document.querySelectorAll<HTMLTimeElement>('.service-identity time').forEach(time=>time.textContent=rel(time.dateTime));
      document.querySelectorAll<HTMLElement>('.history-wrap').forEach(attachHistoryTooltip);

      (async()=>{if(!page||!services)return;try{const key=encodeURIComponent(page.dataset.apiKey??'');await loadEvents();const response=await fetch(`https://updown.io/api/checks?api-key=${key}`);const data=await response.json() as Check[];const checks=[...data].sort((a,b)=>(a.alias?.trim()||`Check ${a.token}`).localeCompare(b.alias?.trim()||`Check ${b.token}`,'en'));const tokens=new Set(checks.map(check=>check.token));services.querySelectorAll<HTMLElement>('.service-row').forEach(row=>{if(!tokens.has(row.dataset.token??''))row.remove()});const hasNew=checks.some(check=>!document.querySelector(`[data-token="${check.token}"]`));if(hasNew){services.classList.add('is-refreshing');services.setAttribute('aria-busy','true')}await Promise.all(checks.map(check=>updateRow(check,key)));services.classList.remove('is-initializing','is-refreshing');services.removeAttribute('aria-busy');const down=checks.some(check=>check.down);const disruptionCount=checks.filter(check=>check.down).length;const maintenanceCount=checks.filter(check=>!check.down&&!check.enabled).length;const operationalCount=checks.length-disruptionCount-maintenanceCount;const countText=disruptionCount||maintenanceCount?[`${operationalCount} Operational`,disruptionCount&&`${disruptionCount} Disruption`,maintenanceCount&&`${maintenanceCount} Maintenance`].filter(Boolean).join(' · '):`${operationalCount} / ${checks.length} Operational`;document.querySelector<HTMLElement>('.status-count')!.textContent=countText;const maintenance=maintenanceCount>0;const overview=document.querySelector<HTMLElement>('.status-overview')!;overview.classList.remove('is-checking','is-operational','has-incident','is-maintenance','is-error');overview.classList.add(down?'has-incident':maintenance?'is-maintenance':'is-operational');document.querySelector<HTMLElement>('.overview-primary')!.textContent=down?'Service disruption detected':maintenance?'Scheduled maintenance':'All systems operational';document.querySelector<HTMLElement>('.overview-secondary')!.textContent=down?'一部のサービスで障害が発生しています':maintenance?'一部のサービスはメンテナンス中です':'すべてのサービスは正常に稼働しています';const updated=document.querySelector<HTMLTimeElement>('.last-updated')!;updated.dateTime=new Date().toISOString();updated.textContent=`Updated ${rel(new Date())}`}catch(error){console.error(error);services?.classList.remove('is-initializing','is-refreshing');services?.removeAttribute('aria-busy');const overview=document.querySelector<HTMLElement>('.status-overview');overview?.classList.remove('is-checking');overview?.classList.add('is-error');document.querySelector<HTMLElement>('.overview-primary')!.textContent='Status unavailable';document.querySelector<HTMLElement>('.overview-secondary')!.textContent='稼働状況を取得できませんでした';document.querySelector<HTMLElement>('.status-count')!.textContent='Unable to update'}})();
    </script>
  </body>
</html>
