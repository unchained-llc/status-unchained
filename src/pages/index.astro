---
import eventsDoc from '../../public/events.json'

type Check = {
  token: string
  url: string
  alias?: string
  enabled: boolean
  published: boolean
  down: boolean
  uptime: number
  last_check_at: string
  displayName?: string
  periodUptime?: number
  history?: DayHistory[]
}

type DayHistory = {
  date: string
  hadDowntime: boolean
  downtimeSeconds: number
  partial: boolean
  utcWindows: string[]
}

type Downtime = { started_at: string; ended_at: string | null; duration?: number; partial?: boolean }
type StatusEventType = 'maintenance_started' | 'maintenance_ended' | 'incident_started' | 'incident_resolved' | 'state_changed'
type StatusEvent = { token: string; alias: string; from: string; to: string; type: StatusEventType; at: string }
type MarkerStatus = 'operational' | 'maintenance' | 'degraded' | 'outage'
type NormalizedEvent = {
  id: string
  serviceId: string
  date: string
  startAt?: string
  endAt?: string
  status: Exclude<MarkerStatus, 'operational'>
  title: string
  description?: string
  ongoing: boolean
}

type DayPayload = {
  date: string
  marker: MarkerStatus
  count: number
  events: NormalizedEvent[]
}

const apiKey = 'ro-REDACTED'
const days = Array.from({ length: 7 }, (_, i) => {
  const d = new Date()
  d.setUTCHours(0, 0, 0, 0)
  d.setUTCDate(d.getUTCDate() - (6 - i))
  return d
})
const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000)
const dayKey = (value: Date | string) => new Date(value).toISOString().slice(0, 10)

const formatUtcDateTime = (ms: number) => {
  const iso = new Date(ms).toISOString().replace(/\.\d{3}Z$/, 'Z')
  return `${iso.slice(0, 10)} ${iso.slice(11)} UTC`
}

const statusFromDowntime = (seconds: number): 'degraded' | 'outage' => (seconds >= 15 * 60 ? 'outage' : 'degraded')

const resolveDowntimeForDay = (downtimes: Downtime[], dayStart: Date, dayEnd: Date) => {
  let totalSeconds = 0
  let partial = false
  const utcWindows: string[] = []
  for (const d of downtimes) {
    const start = new Date(d.started_at).getTime()
    const end = new Date(d.ended_at ?? Date.now()).getTime()
    const overlapStart = Math.max(start, dayStart.getTime())
    const overlapEnd = Math.min(end, dayEnd.getTime())
    if (overlapEnd > overlapStart) {
      totalSeconds += Math.round((overlapEnd - overlapStart) / 1000)
      partial = partial || Boolean(d.partial)
      utcWindows.push(`${formatUtcDateTime(overlapStart)} → ${formatUtcDateTime(overlapEnd)}`)
    }
  }
  return { totalSeconds, partial, utcWindows }
}

const periodUptime = async (token: string) => {
  try {
    const url = `https://updown.io/api/checks/${token}/metrics?api-key=${apiKey}&from=${encodeURIComponent(sevenDaysAgo.toISOString())}&to=${encodeURIComponent(new Date().toISOString())}`
    const r = await fetch(url)
    if (!r.ok) return NaN
    const metrics = (await r.json()) as { uptime: number }
    return Number(metrics.uptime)
  } catch {
    return NaN
  }
}

const history = async (token: string): Promise<DayHistory[]> => {
  try {
    const r = await fetch(`https://updown.io/api/checks/${token}/downtimes?api-key=${apiKey}`)
    const ds = (await r.json()) as Downtime[]
    return days.map((date) => {
      const end = new Date(date)
      end.setUTCDate(end.getUTCDate() + 1)
      const { totalSeconds, partial, utcWindows } = resolveDowntimeForDay(ds, date, end)
      return {
        date: date.toISOString(),
        hadDowntime: totalSeconds > 0,
        downtimeSeconds: totalSeconds,
        partial,
        utcWindows,
      }
    })
  } catch {
    return days.map((date) => ({ date: date.toISOString(), hadDowntime: false, downtimeSeconds: 0, partial: false, utcWindows: [] }))
  }
}

const eventsByToken: Record<string, StatusEvent[]> = {}
;(eventsDoc as { events?: StatusEvent[] }).events?.forEach((event) => {
  if (!event || typeof event.token !== 'string' || typeof event.at !== 'string') return
  if (!eventsByToken[event.token]) eventsByToken[event.token] = []
  eventsByToken[event.token].push(event)
})
Object.values(eventsByToken).forEach((list) => list.sort((a, b) => new Date(a.at).getTime() - new Date(b.at).getTime()))

const parseUtcWindow = (window: string) => {
  const [startRaw, endRaw] = window.split(' → ')
  if (!startRaw || !endRaw) return null
  const toIso = (v: string) => v.replace(' UTC', '').replace(' ', 'T')
  return { startAt: toIso(startRaw), endAt: toIso(endRaw) }
}

const eventsForDay = (serviceId: string, date: string, dayHistory: DayHistory): NormalizedEvent[] => {
  const out: NormalizedEvent[] = []

  if (dayHistory.downtimeSeconds > 0) {
    const status = statusFromDowntime(dayHistory.downtimeSeconds)
    const windows = dayHistory.utcWindows.slice(0, 3)
    if (windows.length > 0) {
      windows.forEach((w, idx) => {
        const parsed = parseUtcWindow(w)
        out.push({
          id: `${serviceId}-${date}-downtime-${idx}`,
          serviceId,
          date,
          startAt: parsed?.startAt,
          endAt: parsed?.endAt,
          status,
          title: status === 'outage' ? 'Voice service unavailable' : 'Service degradation',
          ongoing: false,
        })
      })
    } else {
      out.push({
        id: `${serviceId}-${date}-downtime`,
        serviceId,
        date,
        status,
        title: status === 'outage' ? 'Voice service unavailable' : 'Service degradation',
        ongoing: false,
      })
    }
  }

  const sameDay = (eventsByToken[serviceId] ?? []).filter((event) => dayKey(event.at) === date)
  let maintenanceStart: StatusEvent | null = null
  for (const e of sameDay) {
    if (e.type === 'maintenance_started') {
      maintenanceStart = e
      continue
    }
    if (e.type === 'maintenance_ended') {
      out.push({
        id: `${serviceId}-${e.at}-maintenance`,
        serviceId,
        date,
        startAt: maintenanceStart?.at,
        endAt: e.at,
        status: 'maintenance',
        title: 'Scheduled Maintenance',
        ongoing: false,
      })
      maintenanceStart = null
    }
  }
  if (maintenanceStart) {
    out.push({
      id: `${serviceId}-${maintenanceStart.at}-maintenance-ongoing`,
      serviceId,
      date,
      startAt: maintenanceStart.at,
      status: 'maintenance',
      title: 'Scheduled Maintenance',
      ongoing: true,
    })
  }

  return out.sort((a, b) => new Date(a.startAt ?? a.endAt ?? 0).getTime() - new Date(b.startAt ?? b.endAt ?? 0).getTime())
}

const markerFromEvents = (events: NormalizedEvent[]): MarkerStatus => {
  if (events.some((e) => e.status === 'outage')) return 'outage'
  if (events.some((e) => e.status === 'degraded')) return 'degraded'
  if (events.some((e) => e.status === 'maintenance')) return 'maintenance'
  return 'operational'
}

let checks: Check[] = []
try {
  const response = await fetch(`https://updown.io/api/checks?api-key=${apiKey}`)
  const data = (await response.json()) as Check[]
  const sorted = [...data].sort((a, b) => (a.alias?.trim() || `Check ${a.token}`).localeCompare(b.alias?.trim() || `Check ${b.token}`, 'en'))
  checks = await Promise.all(
    sorted.map(async (c) => ({
      ...c,
      displayName: c.alias?.trim() || `Check ${c.token}`,
      periodUptime: await periodUptime(c.token),
      history: await history(c.token),
    })),
  )
} catch {
  checks = []
}

const now = new Date()
const fmt = (n: number) => (Number.isFinite(n) ? `${n.toFixed(n === 100 ? 0 : 2)}%` : '—')
const dateFmt = (s: string) => new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(s))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Service status provided by UNCHAINED" />
    <title>UNCHAINED | System Status</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260202" />
    <link rel="icon" type="image/png" href="/favicon.png?v=20260202" />
    <link rel="stylesheet" href="/global.css?v=20260729" />
    <noscript><style>.services{opacity:1!important}</style></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@100;200;300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a href="https://www.unchained.co.jp" class="brand" aria-label="UNCHAINED official website">
          <img src="/assets/logo.svg" alt="" width="48" height="48" />
          <span>UNCHAINED</span>
        </a>
      </header>

      <main class="status-page" data-api-key={apiKey}>
        <header class="page-heading">
          <p class="kicker">STATUS</p>
          <h1 class="bilingual-title">
            <span class="en">System Status</span>
            <span class="ja">System operational status</span>
          </h1>
        </header>

        <section class="status-overview is-checking" aria-live="polite">
          <span class="overview-dot"></span>
          <div>
            <p class="overview-primary">Checking systems</p>
            <p class="overview-secondary">Checking current system status</p>
          </div>
          <div class="overview-meta">
            <span class="status-count">Checking current status</span>
            <time class="last-updated" datetime={now.toISOString()}>Live status</time>
          </div>
        </section>

        <section class="services is-initializing" aria-busy="true">
          {checks.map((c) => (
            <article class:list={['service-row', c.down ? 'is-down' : !c.enabled ? 'is-maintenance' : 'is-up']} data-token={c.token}>
              <div class="service-identity">
                <span class="service-dot"></span>
                <div>
                  <h2>{c.displayName}</h2>
                  <p>Last checked <time datetime={c.last_check_at}>{c.last_check_at}</time></p>
                  {c.history && (
                    <div class="history-wrap" data-token={c.token}>
                      <div class="history" role="list" aria-label="7-day history">
                        {c.history.map((d) => {
                          const date = d.date.slice(0, 10)
                          const events = eventsForDay(c.token, date, d)
                          const marker = markerFromEvents(events)
                          const count = events.length
                          const payload = encodeURIComponent(JSON.stringify({ date, marker, count, events } satisfies DayPayload))
                          return (
                            <button
                              type="button"
                              class:list={[
                                'history-day',
                                d.hadDowntime && 'had-downtime',
                                marker !== 'operational' && 'has-event',
                                `marker-${marker}`,
                              ]}
                              data-day-payload={payload}
                              aria-label={`${date} history${count > 0 ? `, ${count} events` : ''}`}
                              aria-expanded="false"
                              aria-controls={`history-card-${c.token}`}
                            >
                              <span class="history-marker" aria-hidden="true"></span>
                            </button>
                          )
                        })}
                      </div>
                      <div class="history-labels">
                        <span>{dateFmt(c.history[0].date)}</span>
                        <span>Today</span>
                      </div>
                      <div class="history-card" id={`history-card-${c.token}`} role="dialog" aria-live="polite" hidden></div>
                    </div>
                  )}
                </div>
              </div>
              <div class="service-result">
                <span class="status-label">{c.down ? 'Disruption' : !c.enabled ? 'Maintenance' : 'Operational'}</span>
                <span class="uptime"><small>7-DAY UPTIME</small>{fmt(Number(c.periodUptime))}</span>
                <a href={`https://updown.io/${c.token}`} target="_blank" rel="noreferrer">↗</a>
              </div>
            </article>
          ))}

          {checks.length === 0 && <div class="empty-state">No public service status information is currently available</div>}
        </section>

        <p class="status-note">Status monitoring by <a href="https://updown.io" target="_blank" rel="noreferrer">updown.io ↗</a></p>
      </main>

      <footer><p>&copy; {now.getFullYear()} UNCHAINED</p></footer>
    </div>

    <script>
      type Check={token:string;alias?:string;enabled:boolean;down:boolean;uptime:number;last_check_at:string}
      type Downtime={started_at:string;ended_at:string|null;duration?:number;partial?:boolean}
      type StatusEventType='maintenance_started'|'maintenance_ended'|'incident_started'|'incident_resolved'|'state_changed'
      type StatusEvent={token:string;alias:string;from:string;to:string;type:StatusEventType;at:string}
      type MarkerStatus='operational'|'maintenance'|'degraded'|'outage'
      type NormalizedEvent={id:string;serviceId:string;date:string;startAt?:string;endAt?:string;status:'maintenance'|'degraded'|'outage';title:string;description?:string;ongoing:boolean}
      type DayPayload={date:string;marker:MarkerStatus;count:number;events:NormalizedEvent[]}

      const page=document.querySelector<HTMLElement>('.status-page')
      const services=document.querySelector<HTMLElement>('.services')
      const eventsByToken:Record<string,StatusEvent[]>={}
      const isMobileView=()=>{const touchOnly=window.matchMedia('(hover: none) and (pointer: coarse)').matches;const hasHoverCapablePointer=window.matchMedia('(any-hover: hover) and (any-pointer: fine)').matches;return touchOnly&&!hasHoverCapablePointer}

      const rel=(value:string|Date)=>{const date=value instanceof Date?value:new Date(value);const seconds=Math.round((date.getTime()-Date.now())/1000);const formatter=new Intl.RelativeTimeFormat('en',{numeric:'auto'});const units:Array<[Intl.RelativeTimeFormatUnit,number]>=[['year',31536000],['month',2592000],['day',86400],['hour',3600],['minute',60],['second',1]];const [unit,amount]=units.find(([,amount])=>Math.abs(seconds)>=amount)??units.at(-1)!;return formatter.format(Math.round(seconds/amount),unit)}
      const formatUptime=(value:number)=>Number.isFinite(value)?`${value.toFixed(value===100?0:2)}%`:'—'
      const dayKey=(value:Date|string)=>new Date(value).toISOString().slice(0,10)
      const hhmm=(value:string)=>new Date(value).toISOString().slice(11,16)
      const formatUtcDateTime=(ms:number)=>{const iso=new Date(ms).toISOString().replace(/\.\d{3}Z$/,'Z');return`${iso.slice(0,10)} ${iso.slice(11)} UTC`}
      const statusFromDowntime=(seconds:number):'degraded'|'outage'=>seconds>=900?'outage':'degraded'

      const loadEvents=async()=>{try{const response=await fetch('/events.json',{cache:'no-store'});if(!response.ok)return;const json=await response.json() as {events?:StatusEvent[]};(json.events??[]).forEach(event=>{if(!event||typeof event.token!=='string'||typeof event.at!=='string')return;if(!eventsByToken[event.token])eventsByToken[event.token]=[];eventsByToken[event.token].push(event)});Object.values(eventsByToken).forEach(list=>list.sort((a,b)=>new Date(a.at).getTime()-new Date(b.at).getTime()))}catch{}}

      const resolveDowntimeForDay=(downtimes:Downtime[],dayStart:Date,dayEnd:Date)=>{let totalSeconds=0;let partial=false;const utcWindows:string[]=[];for(const d of downtimes){const start=new Date(d.started_at).getTime();const end=new Date(d.ended_at??Date.now()).getTime();const overlapStart=Math.max(start,dayStart.getTime());const overlapEnd=Math.min(end,dayEnd.getTime());if(overlapEnd>overlapStart){totalSeconds+=Math.round((overlapEnd-overlapStart)/1000);partial=partial||Boolean(d.partial);utcWindows.push(`${formatUtcDateTime(overlapStart)} → ${formatUtcDateTime(overlapEnd)}`)}}return{totalSeconds,partial,utcWindows}}

      const parseUtcWindow=(window:string)=>{const [startRaw,endRaw]=window.split(' → ');if(!startRaw||!endRaw)return null;const toIso=(v:string)=>v.replace(' UTC','').replace(' ','T');return{startAt:toIso(startRaw),endAt:toIso(endRaw)}};
      const normalizeEventsForDay=(token:string,date:string,dayHistory:{downtimeSeconds:number;partial:boolean;utcWindows:string[]})=>{const out:NormalizedEvent[]=[];if(dayHistory.downtimeSeconds>0){const status=statusFromDowntime(dayHistory.downtimeSeconds);const windows=dayHistory.utcWindows.slice(0,3);if(windows.length>0){windows.forEach((w,idx)=>{const parsed=parseUtcWindow(w);out.push({id:`${token}-${date}-downtime-${idx}`,serviceId:token,date,startAt:parsed?.startAt,endAt:parsed?.endAt,status,title:status==='outage'?'Voice service unavailable':'Service degradation',ongoing:false})})}else{out.push({id:`${token}-${date}-downtime`,serviceId:token,date,status,title:status==='outage'?'Voice service unavailable':'Service degradation',ongoing:false})}}const sameDay=(eventsByToken[token]??[]).filter(event=>dayKey(event.at)===date);let maintenanceStart:StatusEvent|null=null;for(const e of sameDay){if(e.type==='maintenance_started'){maintenanceStart=e;continue}if(e.type==='maintenance_ended'){out.push({id:`${token}-${e.at}-maintenance`,serviceId:token,date,startAt:maintenanceStart?.at,endAt:e.at,status:'maintenance',title:'Scheduled Maintenance',ongoing:false});maintenanceStart=null}}if(maintenanceStart){out.push({id:`${token}-${maintenanceStart.at}-maintenance-ongoing`,serviceId:token,date,startAt:maintenanceStart.at,status:'maintenance',title:'Scheduled Maintenance',ongoing:true})}return out.sort((a,b)=>new Date(a.startAt??a.endAt??0).getTime()-new Date(b.startAt??b.endAt??0).getTime())}

      const markerFromEvents=(events:NormalizedEvent[]):MarkerStatus=>{if(events.some(e=>e.status==='outage'))return'outage';if(events.some(e=>e.status==='degraded'))return'degraded';if(events.some(e=>e.status==='maintenance'))return'maintenance';return'operational'}

      const timeRange=(event:NormalizedEvent)=>{if(event.startAt&&event.endAt)return`${hhmm(event.startAt)}–${hhmm(event.endAt)} UTC`;if(event.startAt)return`${hhmm(event.startAt)}–ongoing UTC`;if(event.endAt)return`ended ${hhmm(event.endAt)} UTC`;return'—'}
      const eventDurationLabel=(event:NormalizedEvent)=>{if(!event.startAt||!event.endAt)return'';const ms=new Date(event.endAt).getTime()-new Date(event.startAt).getTime();if(!Number.isFinite(ms)||ms<=0)return'';const mins=Math.max(1,Math.round(ms/60000));if(mins<60)return `${mins} min`;const hrs=Math.floor(mins/60);const rem=mins%60;if(rem===0)return `${hrs} hr`;return `${hrs} hr ${rem} min`}
      const dayTimelineRanges=(date:string,events:NormalizedEvent[])=>{const toMinutes=(iso:string)=>{const d=new Date(iso);return d.getUTCHours()*60+d.getUTCMinutes()+d.getUTCSeconds()/60};return events.map((event)=>{if(!event.startAt&&!event.endAt)return null;let startMin=event.startAt?toMinutes(event.startAt):event.endAt?toMinutes(event.endAt):0;let endMin=event.endAt?toMinutes(event.endAt):event.startAt?(event.ongoing?toMinutes(new Date().toISOString()):toMinutes(event.startAt)):24*60;if(event.startAt&&dayKey(event.startAt)<date)startMin=0;if(event.endAt&&dayKey(event.endAt)>date)endMin=24*60;if(endMin<startMin)endMin=startMin+1;const startPct=(startMin/(24*60))*100;const endPct=(endMin/(24*60))*100;return{status:event.status,startPct,endPct}}).filter(Boolean) as Array<{status:NormalizedEvent['status'];startPct:number;endPct:number}>}
      const dayTimelineProgressPct=(date:string)=>{const today=dayKey(new Date());if(date<today)return 100;if(date>today)return 0;const now=new Date();const mins=now.getUTCHours()*60+now.getUTCMinutes()+now.getUTCSeconds()/60;return Math.max(0,Math.min(100,(mins/(24*60))*100))}

      let activeWrap:HTMLElement|null=null
      let activeBtn:HTMLButtonElement|null=null
      let lockOpen=false
      const hideTimers=new WeakMap<HTMLElement,number>()

      const closeActiveCard=()=>{if(!activeWrap)return;const card=activeWrap.querySelector<HTMLElement>('.history-card');if(card){const pending=hideTimers.get(card);if(pending)window.clearTimeout(pending);card.classList.remove('is-open');const timer=window.setTimeout(()=>{card.hidden=true},120);hideTimers.set(card,timer)}activeWrap.classList.remove('has-history-card','is-locked');delete activeWrap.dataset.activeMarker;activeWrap.querySelectorAll<HTMLButtonElement>('.history-day[aria-expanded="true"]').forEach(btn=>btn.setAttribute('aria-expanded','false'));activeWrap.querySelectorAll('.history-day.is-active').forEach(el=>el.classList.remove('is-active'));activeWrap=null;activeBtn=null;lockOpen=false}

      const positionCard=(wrap:HTMLElement,btn:HTMLButtonElement,card:HTMLElement)=>{if(isMobileView()){card.style.removeProperty('left');card.style.removeProperty('--card-arrow');wrap.style.removeProperty('--card-anchor-x');wrap.style.removeProperty('--card-anchor-y');wrap.style.removeProperty('--card-connector-h');return}const wrapRect=wrap.getBoundingClientRect();const refRect=btn.getBoundingClientRect();const centerX=refRect.left-wrapRect.left+refRect.width/2;const anchorY=refRect.bottom-wrapRect.top;const width=card.offsetWidth||360;const maxLeft=Math.max(0,wrapRect.width-width);const left=Math.min(maxLeft,Math.max(0,centerX-width/2));const arrow=Math.min(width-14,Math.max(14,centerX-left));card.style.left=`${left}px`;card.style.setProperty('--card-arrow',`${arrow}px`);wrap.style.setProperty('--card-anchor-x',`${centerX}px`);wrap.style.setProperty('--card-anchor-y',`${anchorY}px`);const connectorH=Math.max(10,card.offsetTop-anchorY-2);wrap.style.setProperty('--card-connector-h',`${connectorH}px`)}

      const renderCard=(wrap:HTMLElement,btn:HTMLButtonElement,payload:DayPayload,locked:boolean)=>{if(activeWrap&&activeWrap!==wrap)closeActiveCard();const card=wrap.querySelector<HTMLElement>('.history-card');if(!card)return;card.replaceChildren();const row=wrap.closest<HTMLElement>('.service-row');const liveMarker=row?.classList.contains('is-down')?'outage':row?.classList.contains('is-maintenance')?'maintenance':'operational';

        const dateEl=document.createElement('p');dateEl.className='history-card-date';dateEl.textContent=payload.date;card.append(dateEl)

        const list=document.createElement('div');list.className='history-card-list';
        const events=(payload.events.length>0?payload.events:[null]).slice(0,3)
        events.forEach((event)=>{const block=document.createElement('section');block.className='history-card-entry';if(event){const line=document.createElement('div');line.className='history-card-line';const left=document.createElement('div');left.className='history-card-left';const icon=document.createElement('span');icon.className=`history-card-event-icon is-${event.status}`;const copy=document.createElement('div');copy.className='history-card-copy';const title=document.createElement('p');title.className='history-card-title';title.textContent=event.title;copy.append(title);const meta=document.createElement('p');meta.className='history-card-meta-line';meta.textContent=timeRange(event);const durationLabel=eventDurationLabel(event);if(durationLabel){const bullet=document.createElement('span');bullet.className='sep';bullet.textContent='•';const duration=document.createElement('span');duration.className='history-card-duration';duration.textContent=durationLabel;meta.append(bullet,duration)}copy.append(meta);if(event.ongoing){const status=document.createElement('p');status.className='history-card-status is-ongoing';status.textContent='Ongoing';copy.append(status)}left.append(icon,copy);line.append(left);block.append(line)}else{const empty=document.createElement('p');empty.className='history-card-empty';empty.textContent='No notable events';block.append(empty)}list.append(block)});
        card.append(list)

        if(payload.events.length>0){
          const labels=document.createElement('div');labels.className='history-dayline-labels';['00','06','12','18','24'].forEach(text=>{const node=document.createElement('span');node.textContent=text;labels.append(node)});card.append(labels)
          const rail=document.createElement('div');rail.className='history-dayline-rail';const progressPct=dayTimelineProgressPct(payload.date);const base=document.createElement('span');base.className='history-dayline-base';rail.append(base);const progress=document.createElement('span');progress.className='history-dayline-progress';progress.style.width=`${progressPct}%`;rail.append(progress);[25,50,75].forEach(v=>{const tick=document.createElement('span');tick.className='history-dayline-tick';tick.style.left=`${v}%`;rail.append(tick)});dayTimelineRanges(payload.date,payload.events).forEach(range=>{const seg=document.createElement('span');seg.className=`history-dayline-highlight is-${range.status}`;seg.style.left=`${range.startPct}%`;seg.style.width=`${Math.max(1.2,range.endPct-range.startPct)}%`;rail.append(seg)});if(payload.date===dayKey(new Date())){const now=document.createElement('span');now.className=`history-dayline-now is-${liveMarker}`;now.style.left=`${progressPct}%`;now.innerHTML='<span class="dot"></span><span class="stem"></span><span class="label">Now</span>';rail.append(now)}card.append(rail)
        }

        wrap.querySelectorAll<HTMLButtonElement>('.history-day').forEach(node=>{node.setAttribute('aria-expanded','false');node.classList.remove('is-active')})
        btn.setAttribute('aria-expanded','true');btn.classList.add('is-active')
        const pending=hideTimers.get(card);if(pending)window.clearTimeout(pending)
        card.hidden=false
        wrap.classList.add('has-history-card')
        const isTodaySlot=btn.parentElement?.lastElementChild===btn
        wrap.dataset.activeMarker=isTodaySlot?liveMarker:(btn.classList.contains('had-downtime')?'outage':payload.marker)
        if(locked)wrap.classList.add('is-locked');else wrap.classList.remove('is-locked')
        positionCard(wrap,btn,card)
        requestAnimationFrame(()=>card.classList.add('is-open'))
        activeWrap=wrap
        activeBtn=btn
        lockOpen=locked
      }

      const openFromButton=(btn:HTMLButtonElement,locked:boolean)=>{const wrap=btn.closest<HTMLElement>('.history-wrap');if(!wrap)return;const raw=btn.dataset.dayPayload;if(!raw)return;let payload:DayPayload;try{payload=JSON.parse(decodeURIComponent(raw)) as DayPayload}catch{return}renderCard(wrap,btn,payload,locked)}

      const attachHistoryCard=(wrap:HTMLElement)=>{
        if(wrap.dataset.cardBound==='true')return

        const pickButton=(target:EventTarget|null)=>{
          if(!(target instanceof Element))return null
          const btn=target.closest<HTMLButtonElement>('.history-day')
          return btn&&wrap.contains(btn)?btn:null
        }

        wrap.addEventListener('mouseover',(event)=>{
          if(isMobileView())return
          const btn=pickButton(event.target)
          if(!btn)return
          if(activeBtn===btn&&activeWrap===wrap)return
          openFromButton(btn,false)
        })

        wrap.addEventListener('mousemove',(event)=>{
          if(isMobileView())return
          const btn=pickButton(event.target)
          if(!btn){
            if(activeWrap===wrap&&!lockOpen)closeActiveCard()
            return
          }
          if(activeBtn!==btn||activeWrap!==wrap)openFromButton(btn,false)
        })

        wrap.addEventListener('focusin',(event)=>{
          if(lockOpen)return
          const btn=pickButton(event.target)
          if(!btn)return
          openFromButton(btn,false)
        })

        wrap.addEventListener('click',(event)=>{
          const btn=pickButton(event.target)
          if(!btn)return
          event.preventDefault()
          if(activeBtn===btn&&lockOpen){closeActiveCard();return}
          openFromButton(btn,true)
        })

        wrap.addEventListener('keydown',(event)=>{
          const btn=pickButton(event.target)
          if(!btn)return
          if(event.key==='Enter'||event.key===' '){
            event.preventDefault()
            if(activeBtn===btn&&lockOpen){closeActiveCard();return}
            openFromButton(btn,true)
          }
        })

        wrap.addEventListener('mouseleave',()=>{if(lockOpen||isMobileView())return;closeActiveCard()})
        wrap.dataset.cardBound='true'
      }

      document.addEventListener('click',(event)=>{const target=event.target as Node;if(activeWrap&& !activeWrap.contains(target))closeActiveCard()})
      document.addEventListener('keydown',(event)=>{if(event.key==='Escape')closeActiveCard()})
      window.addEventListener('resize',()=>{if(activeWrap&&activeBtn){const card=activeWrap.querySelector<HTMLElement>('.history-card');if(card&&!card.hidden)positionCard(activeWrap,activeBtn,card)}})
      window.addEventListener('scroll',()=>{if(activeWrap&&activeBtn){if(lockOpen){const card=activeWrap.querySelector<HTMLElement>('.history-card');if(card&&!card.hidden)positionCard(activeWrap,activeBtn,card)}else closeActiveCard()}},{passive:true})

      const createRow=(check:Check)=>{const row=document.createElement('article');row.className='service-row';row.dataset.token=check.token;row.innerHTML=`<div class="service-identity"><span class="service-dot"></span><div><h2></h2><p>Last checked <time></time></p><div class="history-wrap" data-token="${check.token}"><div class="history" role="list" aria-label="7-day history"></div><div class="history-labels"><span></span><span>Today</span></div><div class="history-card" id="history-card-${check.token}" role="dialog" aria-live="polite" hidden></div></div></div></div><div class="service-result"><span class="status-label"></span><span class="uptime"><small>7-DAY UPTIME</small>—</span><a target="_blank" rel="noreferrer">↗</a></div>`;row.querySelector<HTMLAnchorElement>('.service-result a')!.href=`https://updown.io/${check.token}`;attachHistoryCard(row.querySelector<HTMLElement>('.history-wrap')!);return row}

      const updateHistory=async(row:HTMLElement,check:Check,key:string)=>{try{const response=await fetch(`https://updown.io/api/checks/${check.token}/downtimes?api-key=${key}`);const downtimes=await response.json() as Downtime[];const dates=Array.from({length:7},(_,index)=>{const date=new Date();date.setUTCHours(0,0,0,0);date.setUTCDate(date.getUTCDate()-(6-index));return date});const history=row.querySelector<HTMLElement>('.history')!;history.replaceChildren(...dates.map(date=>{const end=new Date(date);end.setUTCDate(end.getUTCDate()+1);const {totalSeconds,partial,utcWindows}=resolveDowntimeForDay(downtimes,date,end);const dateStr=dayKey(date);const events=normalizeEventsForDay(check.token,dateStr,{downtimeSeconds:totalSeconds,partial,utcWindows});const marker=markerFromEvents(events);const btn=document.createElement('button');btn.type='button';btn.className=`history-day${totalSeconds>0?' had-downtime':''}${marker!=='operational'?' has-event':''} marker-${marker}`;btn.dataset.dayPayload=encodeURIComponent(JSON.stringify({date:dateStr,marker,count:events.length,events} satisfies DayPayload));btn.setAttribute('aria-label',`${dateStr} history${events.length?`, ${events.length} events`:''}`);btn.setAttribute('aria-expanded','false');btn.setAttribute('aria-controls',`history-card-${check.token}`);btn.innerHTML=`<span class="history-marker" aria-hidden="true"></span>`;return btn}));row.querySelector<HTMLElement>('.history-labels span')!.textContent=new Intl.DateTimeFormat('en',{month:'short',day:'numeric',timeZone:'UTC'}).format(dates[0]);attachHistoryCard(row.querySelector<HTMLElement>('.history-wrap')!)}catch{}}

      const updateRow=async(check:Check,key:string)=>{if(!services)return;let row=document.querySelector<HTMLElement>(`[data-token="${check.token}"]`);if(!row)row=createRow(check);services.append(row);row.classList.toggle('is-down',check.down);row.classList.toggle('is-maintenance',!check.enabled);row.classList.toggle('is-up',!check.down&&check.enabled);row.querySelector<HTMLElement>('.service-identity h2')!.textContent=check.alias?.trim()||`Check ${check.token}`;row.querySelector<HTMLElement>('.status-label')!.textContent=check.down?'Disruption':!check.enabled?'Maintenance':'Operational';const time=row.querySelector<HTMLTimeElement>('.service-identity time')!;time.dateTime=check.last_check_at;time.textContent=rel(check.last_check_at);try{const from=new Date(Date.now()-7*24*60*60*1000).toISOString();const response=await fetch(`https://updown.io/api/checks/${check.token}/metrics?api-key=${key}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(new Date().toISOString())}`);const metrics=await response.json() as {uptime:number};row.querySelector<HTMLElement>('.uptime')!.lastChild!.textContent=formatUptime(Number(metrics.uptime))}catch{row.querySelector<HTMLElement>('.uptime')!.lastChild!.textContent='—'}await updateHistory(row,check,key)}

      document.querySelectorAll<HTMLTimeElement>('.service-identity time').forEach(time=>time.textContent=rel(time.dateTime))
      document.querySelectorAll<HTMLElement>('.history-wrap').forEach(attachHistoryCard)

      ;(async()=>{if(!page||!services)return;try{const key=encodeURIComponent(page.dataset.apiKey??'');await loadEvents();const response=await fetch(`https://updown.io/api/checks?api-key=${key}`);const data=await response.json() as Check[];const checks=[...data].sort((a,b)=>(a.alias?.trim()||`Check ${a.token}`).localeCompare(b.alias?.trim()||`Check ${b.token}`,'en'));const tokens=new Set(checks.map(check=>check.token));services.querySelectorAll<HTMLElement>('.service-row').forEach(row=>{if(!tokens.has(row.dataset.token??''))row.remove()});const hasNew=checks.some(check=>!document.querySelector(`[data-token="${check.token}"]`));if(hasNew){services.classList.add('is-refreshing');services.setAttribute('aria-busy','true')}await Promise.all(checks.map(check=>updateRow(check,key)));services.classList.remove('is-initializing','is-refreshing');services.removeAttribute('aria-busy');const down=checks.some(check=>check.down);const disruptionCount=checks.filter(check=>check.down).length;const maintenanceCount=checks.filter(check=>!check.down&&!check.enabled).length;const operationalCount=checks.length-disruptionCount-maintenanceCount;const countText=disruptionCount||maintenanceCount?[`${operationalCount} Operational`,disruptionCount&&`${disruptionCount} Disruption`,maintenanceCount&&`${maintenanceCount} Maintenance`].filter(Boolean).join(' · '):`${operationalCount} / ${checks.length} Operational`;document.querySelector<HTMLElement>('.status-count')!.textContent=countText;const maintenance=maintenanceCount>0;const overview=document.querySelector<HTMLElement>('.status-overview')!;overview.classList.remove('is-checking','is-operational','has-incident','is-maintenance','is-error');overview.classList.add(down?'has-incident':maintenance?'is-maintenance':'is-operational');document.querySelector<HTMLElement>('.overview-primary')!.textContent=down?'Service disruption detected':maintenance?'Scheduled maintenance':'All systems operational';document.querySelector<HTMLElement>('.overview-secondary')!.textContent=down?'Some services are currently experiencing disruptions':maintenance?'Some services are currently under maintenance':'All services are operating normally';const updated=document.querySelector<HTMLTimeElement>('.last-updated')!;updated.dateTime=new Date().toISOString();updated.textContent=`Updated ${rel(new Date())}`}catch(error){console.error(error);services?.classList.remove('is-initializing','is-refreshing');services?.removeAttribute('aria-busy');const overview=document.querySelector<HTMLElement>('.status-overview');overview?.classList.remove('is-checking');overview?.classList.add('is-error');document.querySelector<HTMLElement>('.overview-primary')!.textContent='Status unavailable';document.querySelector<HTMLElement>('.overview-secondary')!.textContent='Failed to retrieve service status';document.querySelector<HTMLElement>('.status-count')!.textContent='Unable to update'}})()
    </script>
  </body>
</html>
