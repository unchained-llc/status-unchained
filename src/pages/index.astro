---
import Nav from '../components/Nav.astro'

type Check = {
  token: string
  url: string
  alias?: string
  enabled: boolean
  published: boolean
  down: boolean
  uptime: number
  last_check_at: string
  displayName?: string
  periodUptime?: number
  history?: DayHistory[]
}

type DayHistory = {
  date: string
  hadDowntime: boolean
  downtimeSeconds: number
  partial: boolean
  utcWindows: string[]
}


type StatusEventType = 'maintenance_started' | 'maintenance_ended' | 'incident_started' | 'incident_resolved' | 'state_changed'
type StatusEvent = { token: string; alias: string; from: string; to: string; type: StatusEventType; at: string }
type MarkerStatus = 'operational' | 'maintenance' | 'degraded' | 'outage'
type NormalizedEvent = {
  id: string
  serviceId: string
  date: string
  startAt?: string
  endAt?: string
  status: Exclude<MarkerStatus, 'operational'>
  title: string
  description?: string
  ongoing: boolean
}

type DayPayload = {
  date: string
  marker: MarkerStatus
  count: number
  events: NormalizedEvent[]
}


const dayKey = (value: Date | string) => new Date(value).toISOString().slice(0, 10)
const ledPhaseMs = (token: string) => {
  let hash = 0
  for (const ch of token) hash = (hash * 33 + ch.charCodeAt(0)) >>> 0
  return -(hash % 1200)
}



const statusFromDowntime = (seconds: number): 'degraded' | 'outage' => (seconds >= 15 * 60 ? 'outage' : 'degraded')





const eventsByToken: Record<string, StatusEvent[]> = {}

const parseUtcWindow = (window: string) => {
  const [startRaw, endRaw] = window.split(' → ')
  if (!startRaw || !endRaw) return null
  const toIso = (v: string) => v.replace(' UTC', '').replace(' ', 'T')
  return { startAt: toIso(startRaw), endAt: toIso(endRaw) }
}

const eventsForDay = (serviceId: string, date: string, dayHistory: DayHistory): NormalizedEvent[] => {
  const out: NormalizedEvent[] = []

  if (dayHistory.downtimeSeconds > 0) {
    const status = statusFromDowntime(dayHistory.downtimeSeconds)
    const windows = dayHistory.utcWindows.slice(0, 3)
    if (windows.length > 0) {
      windows.forEach((w, idx) => {
        const parsed = parseUtcWindow(w)
        out.push({
          id: `${serviceId}-${date}-downtime-${idx}`,
          serviceId,
          date,
          startAt: parsed?.startAt,
          endAt: parsed?.endAt,
          status,
          title: status === 'outage' ? 'Service Unavailable' : 'Service Degradation',
          ongoing: false,
        })
      })
    } else {
      out.push({
        id: `${serviceId}-${date}-downtime`,
        serviceId,
        date,
        status,
        title: status === 'outage' ? 'Service Unavailable' : 'Service Degradation',
        ongoing: false,
      })
    }
  }

  const sameDay = (eventsByToken[serviceId] ?? []).filter((event) => dayKey(event.at) === date)
  let maintenanceStart: StatusEvent | null = null
  for (const e of sameDay) {
    if (e.type === 'maintenance_started') {
      maintenanceStart = e
      continue
    }
    if (e.type === 'maintenance_ended') {
      out.push({
        id: `${serviceId}-${e.at}-maintenance`,
        serviceId,
        date,
        startAt: maintenanceStart?.at,
        endAt: e.at,
        status: 'maintenance',
        title: 'Scheduled Maintenance',
        ongoing: false,
      })
      maintenanceStart = null
    }
  }
  if (maintenanceStart) {
    out.push({
      id: `${serviceId}-${maintenanceStart.at}-maintenance-ongoing`,
      serviceId,
      date,
      startAt: maintenanceStart.at,
      status: 'maintenance',
      title: 'Scheduled Maintenance',
      ongoing: true,
    })
  }

  return out.sort((a, b) => new Date(a.startAt ?? a.endAt ?? 0).getTime() - new Date(b.startAt ?? b.endAt ?? 0).getTime())
}

const markerFromEvents = (events: NormalizedEvent[]): MarkerStatus => {
  if (events.some((e) => e.status === 'outage')) return 'outage'
  if (events.some((e) => e.status === 'degraded')) return 'degraded'
  if (events.some((e) => e.status === 'maintenance')) return 'maintenance'
  return 'operational'
}

const checks: Check[] = []

const now = new Date()
const fmt = (n: number) => (Number.isFinite(n) ? `${n.toFixed(n === 100 ? 0 : 2)}%` : '—')
const dateFmt = (s: string) => new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' }).format(new Date(s))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Service status provided by UNCHAINED" />
    <title>UNCHAINED | System Status</title>
    <script is:inline>
      // Inlined in head to avoid theme flash.
      const USER_THEME_TTL_MS = 24 * 60 * 60 * 1000;
      const getThemePreference = () => {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const osTheme = prefersDark ? 'dark' : 'light';
        if (typeof localStorage === 'undefined') return { theme: osTheme, source: 'os' };
        const userSet = localStorage.getItem('theme-user') === '1';
        const stored = localStorage.getItem('theme');
        const userSetAtRaw = localStorage.getItem('theme-user-at');
        const userSetAt = userSetAtRaw ? Number(userSetAtRaw) : NaN;
        const osAtSet = localStorage.getItem('theme-os-at-set');
        const userChoiceActive = Number.isFinite(userSetAt) && Date.now() - userSetAt < USER_THEME_TTL_MS;
        const osChangedSinceUserSet = !!osAtSet && osAtSet !== osTheme;
        if (userSet && stored && userChoiceActive && !osChangedSinceUserSet && stored !== osTheme) return { theme: stored, source: 'user' };
        if (userSet) {
          localStorage.removeItem('theme-user');
          localStorage.removeItem('theme-user-at');
          localStorage.removeItem('theme-os-at-set');
        }
        return { theme: osTheme, source: 'os' };
      };
      const pref = getThemePreference();
      const isDark = pref.theme === 'dark';
      document.documentElement.classList.toggle('theme-dark', isDark);
      document.documentElement.classList.toggle('theme-light', !isDark);
      document.documentElement.dataset.theme = pref.theme;
      document.documentElement.dataset.themeSource = pref.source;
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260202" />
    <link rel="icon" type="image/png" href="/favicon.png?v=20260202" />
    <link rel="stylesheet" href="/global.css?v=20260729" />
    <noscript><style>.services{opacity:1!important}</style></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@100;200;300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <Nav />
      </header>

      <main class="status-page">
        <header class="page-heading">
          <h1 class="bilingual-title">
            <span class="en">System Status</span>
            <span class="ja">システム稼働状況</span>
          </h1>
          <p class="bilingual-lead">
            <span class="en">Real-time operational status for services and infrastructure.</span>
            <span class="ja">サービスおよびインフラストラクチャの稼働状況をリアルタイムで公開しています</span>
          </p>
        </header>

        <section class="status-overview is-checking" aria-live="polite">
          <span class="overview-dot"></span>
          <div>
            <p class="overview-primary">Checking systems</p>
            <p class="overview-secondary">Checking current system status</p>
          </div>
          <div class="overview-meta">
            <span class="status-count">Checking current status</span>
            <span class="events-freshness" hidden>Last update unavailable</span>
          </div>
        </section>

        <section class="services is-initializing" aria-busy="true">
          {checks.map((c) => (
            <article class:list={['service-row', c.down ? 'is-down' : !c.enabled ? 'is-maintenance' : 'is-up']} data-token={c.token} style={`--today-led-delay:${ledPhaseMs(c.token)}ms;`}>
              <div class="service-identity">
                <span class="service-dot"></span>
                <div>
                  <div class="service-headline">
                    <h2>{c.displayName}</h2>
                  </div>
                  {c.history && (
                    <div class="history-wrap" data-token={c.token}>
                      <div class="history" role="list" aria-label="7-day history">
                        {c.history.map((d) => {
                          const date = d.date.slice(0, 10)
                          const events = eventsForDay(c.token, date, d)
                          const marker = markerFromEvents(events)
                          const count = events.length
                          const payload = encodeURIComponent(JSON.stringify({ date, marker, count, events } satisfies DayPayload))
                          return (
                            <button
                              type="button"
                              class:list={[
                                'history-day',
                                d.hadDowntime && 'had-downtime',
                                marker !== 'operational' && 'has-event',
                                `marker-${marker}`,
                              ]}
                              data-day-payload={payload}
                              aria-label={`${date} history${count > 0 ? `, ${count} events` : ''}`}
                              aria-expanded="false"
                              aria-controls={`history-card-${c.token}`}
                            >
                              <span class="history-marker" aria-hidden="true"></span>
                            </button>
                          )
                        })}
                      </div>
                      <div class="history-labels">
                        <span>{dateFmt(c.history[0].date)}</span>
                        <span>Today</span>
                      </div>
                      <div class="history-card" id={`history-card-${c.token}`} role="dialog" aria-live="polite" hidden></div>
                    </div>
                  )}
                  <p class="service-meta">Last checked <time datetime={c.last_check_at}>{c.last_check_at}</time></p>
                </div>
              </div>
              <div class="service-result">
                <div class="status-with-badge">
                  <span class="status-label">{c.down ? 'Disruption' : !c.enabled ? 'Maintenance' : 'Operational'}</span>
                  <button type="button" class="history-event-badge" hidden aria-label="Event count" aria-expanded="false"><span class="history-event-badge-dot" aria-hidden="true"></span><span class="history-event-badge-count"></span></button>
                </div>
                <span class="uptime"><small>7-DAY UPTIME</small>{fmt(Number(c.periodUptime))}</span>
                <a href={`https://updown.io/${c.token}`} target="_blank" rel="noreferrer">↗</a>
              </div>
            </article>
          ))}


        </section>

        <p class="status-note">Status monitoring by <a href="https://updown.io" target="_blank" rel="noreferrer">updown.io ↗</a></p>

      </main>

      <footer><p>&copy; {now.getFullYear()} UNCHAINED</p></footer>
    </div>

    <script>
      type DayHistory={date:string;hadDowntime:boolean;downtimeSeconds:number;partial:boolean;utcWindows:string[]}
      type Check={token:string;alias?:string;enabled:boolean;down:boolean;uptime:number;last_check_at:string;periodUptime?:number;history?:DayHistory[]}
      type Downtime={started_at:string;ended_at:string|null;duration?:number;partial?:boolean}
      type StatusEventType='maintenance_started'|'maintenance_ended'|'incident_started'|'incident_resolved'|'state_changed'
      type StatusEvent={token:string;alias:string;from:string;to:string;type:StatusEventType;at:string}
      type MarkerStatus='operational'|'maintenance'|'degraded'|'outage'
      type NormalizedEvent={id:string;serviceId:string;date:string;startAt?:string;endAt?:string;status:'maintenance'|'degraded'|'outage';title:string;description?:string;ongoing:boolean}
      type DayPayload={date:string;marker:MarkerStatus;count:number;events:NormalizedEvent[]}
      type BadgeSummaryDay={date:string;events:NormalizedEvent[]}
      type EventsResponse={generated_at?:string|null;checked_at?:string|null;events?:StatusEvent[]}

      const page=document.querySelector<HTMLElement>('.status-page')
      const services=document.querySelector<HTMLElement>('.services')
      const eventsFreshness=document.querySelector<HTMLElement>('.events-freshness')
      const eventsByToken:Record<string,StatusEvent[]>={}
      const EVENTS_DELAY_MS=3*60*1000
      const isMobileView=()=>{const touchOnly=window.matchMedia('(hover: none) and (pointer: coarse)').matches;const hasHoverCapablePointer=window.matchMedia('(any-hover: hover) and (any-pointer: fine)').matches;return touchOnly&&!hasHoverCapablePointer}

      const rel=(value:string|Date)=>{const date=value instanceof Date?value:new Date(value);const seconds=Math.round((date.getTime()-Date.now())/1000);const formatter=new Intl.RelativeTimeFormat('en',{numeric:'auto'});const units:Array<[Intl.RelativeTimeFormatUnit,number]>=[['year',31536000],['month',2592000],['day',86400],['hour',3600],['minute',60],['second',1]];const [unit,amount]=units.find(([,amount])=>Math.abs(seconds)>=amount)??units.at(-1)!;return formatter.format(Math.round(seconds/amount),unit)}
      const formatUptime=(value:number)=>Number.isFinite(value)?`${value.toFixed(value===100?0:2)}%`:'—'
      const dayKey=(value:Date|string)=>new Date(value).toISOString().slice(0,10)
      const hhmm=(value:string)=>{const d=new Date(value);return`${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`}
      const formatUtcDateTime=(ms:number)=>{const iso=new Date(ms).toISOString().replace(/\.\d{3}Z$/,'Z');return`${iso.slice(0,10)} ${iso.slice(11)} UTC`}
      const localYmd=(value:Date|string)=>{const d=value instanceof Date?value:new Date(value);return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
      const localDateLabel=(value:Date|string)=>new Intl.DateTimeFormat(undefined,{dateStyle:'medium'}).format(value instanceof Date?value:new Date(value))
      const localTzName=(value:Date|string)=>{const d=value instanceof Date?value:new Date(value);const part=new Intl.DateTimeFormat(undefined,{timeZoneName:'short'}).formatToParts(d).find((p)=>p.type==='timeZoneName');return part?.value??''}
      const statusFromDowntime=(seconds:number):'degraded'|'outage'=>seconds>=900?'outage':'degraded'
      const ledPhaseMs=(token:string)=>{let hash=0;for(const ch of token)hash=(hash*33+ch.charCodeAt(0))>>>0;return-(hash%1200)}

      const loadEvents=async()=>{try{const response=await fetch('/api/events.json',{cache:'no-store'});if(!response.ok)return null;Object.keys(eventsByToken).forEach(key=>delete eventsByToken[key]);const json=await response.json() as EventsResponse;(json.events??[]).forEach(event=>{if(!event||typeof event.token!=='string'||typeof event.at!=='string')return;if(!eventsByToken[event.token])eventsByToken[event.token]=[];eventsByToken[event.token].push(event)});Object.values(eventsByToken).forEach(list=>list.sort((a,b)=>new Date(a.at).getTime()-new Date(b.at).getTime()));return{generatedAt:typeof json.generated_at==='string'?json.generated_at:null,checkedAt:typeof json.checked_at==='string'?json.checked_at:new Date().toISOString()}}catch{return null}}

      const resolveDowntimeForDay=(downtimes:Downtime[],dayStart:Date,dayEnd:Date)=>{let totalSeconds=0;let partial=false;const utcWindows:string[]=[];for(const d of downtimes){const start=new Date(d.started_at).getTime();const end=new Date(d.ended_at??Date.now()).getTime();const overlapStart=Math.max(start,dayStart.getTime());const overlapEnd=Math.min(end,dayEnd.getTime());if(overlapEnd>overlapStart){totalSeconds+=Math.round((overlapEnd-overlapStart)/1000);partial=partial||Boolean(d.partial);utcWindows.push(`${formatUtcDateTime(overlapStart)} → ${formatUtcDateTime(overlapEnd)}`)}}return{totalSeconds,partial,utcWindows}}

      const parseUtcWindow=(window:string)=>{const [startRaw,endRaw]=window.split(' → ');if(!startRaw||!endRaw)return null;const toIso=(v:string)=>v.replace(' UTC','').replace(' ','T');return{startAt:toIso(startRaw),endAt:toIso(endRaw)}};
      const normalizeEventsForDay=(token:string,date:string,dayHistory:{downtimeSeconds:number;partial:boolean;utcWindows:string[]})=>{const out:NormalizedEvent[]=[];if(dayHistory.downtimeSeconds>0){const status=statusFromDowntime(dayHistory.downtimeSeconds);const windows=dayHistory.utcWindows.slice(0,3);if(windows.length>0){windows.forEach((w,idx)=>{const parsed=parseUtcWindow(w);out.push({id:`${token}-${date}-downtime-${idx}`,serviceId:token,date,startAt:parsed?.startAt,endAt:parsed?.endAt,status,title:status==='outage'?'Service Unavailable':'Service Degradation',ongoing:false})})}else{out.push({id:`${token}-${date}-downtime`,serviceId:token,date,status,title:status==='outage'?'Service Unavailable':'Service Degradation',ongoing:false})}}const sameDay=(eventsByToken[token]??[]).filter(event=>dayKey(event.at)===date);let maintenanceStart:StatusEvent|null=null;for(const e of sameDay){if(e.type==='maintenance_started'){maintenanceStart=e;continue}if(e.type==='maintenance_ended'){out.push({id:`${token}-${e.at}-maintenance`,serviceId:token,date,startAt:maintenanceStart?.at,endAt:e.at,status:'maintenance',title:'Scheduled Maintenance',ongoing:false});maintenanceStart=null}}if(maintenanceStart){out.push({id:`${token}-${maintenanceStart.at}-maintenance-ongoing`,serviceId:token,date,startAt:maintenanceStart.at,status:'maintenance',title:'Scheduled Maintenance',ongoing:true})}return out.sort((a,b)=>new Date(a.startAt??a.endAt??0).getTime()-new Date(b.startAt??b.endAt??0).getTime())}

      const markerFromEvents=(events:NormalizedEvent[]):MarkerStatus=>{if(events.some(e=>e.status==='outage'))return'outage';if(events.some(e=>e.status==='degraded'))return'degraded';if(events.some(e=>e.status==='maintenance'))return'maintenance';return'operational'}

      const timeRange=(event:NormalizedEvent)=>{if(event.startAt&&event.endAt)return`${hhmm(event.startAt)}–${hhmm(event.endAt)} ${localTzName(event.startAt)}`.trim();if(event.startAt)return`${hhmm(event.startAt)}–ongoing ${localTzName(event.startAt)}`.trim();if(event.endAt)return`ended ${hhmm(event.endAt)} ${localTzName(event.endAt)}`.trim();return'—'}
      const eventDurationLabel=(event:NormalizedEvent)=>{if(!event.startAt||!event.endAt)return'';const ms=new Date(event.endAt).getTime()-new Date(event.startAt).getTime();if(!Number.isFinite(ms)||ms<=0)return'';const mins=Math.max(1,Math.round(ms/60000));if(mins<60)return `${mins} min`;const hrs=Math.floor(mins/60);const rem=mins%60;if(rem===0)return `${hrs} hr`;return `${hrs} hr ${rem} min`}
      const dayTimelineRanges=(date:string,events:NormalizedEvent[])=>{const localDate=localYmd(date);const minMinutes=1;const toLocalMinutes=(ms:number)=>{const t=new Date(ms);return t.getHours()*60+t.getMinutes()+t.getSeconds()/60};const clampMinutes=(v:number)=>Math.max(0,Math.min(24*60,v));return events.map((event)=>{if(!event.startAt&&!event.endAt)return null;const startMs=event.startAt?new Date(event.startAt).getTime():event.endAt?new Date(event.endAt).getTime():NaN;const rawEnd=event.endAt?new Date(event.endAt).getTime():event.startAt?(event.ongoing?Date.now():new Date(event.startAt).getTime()):NaN;if(!Number.isFinite(startMs)||!Number.isFinite(rawEnd))return null;const endMs=Math.max(startMs,rawEnd);const startDate=localYmd(new Date(startMs));const endDate=localYmd(new Date(endMs));let startMin=toLocalMinutes(startMs);let endMin=toLocalMinutes(endMs);if(startDate===endDate){if(startDate!==localDate)return null;if(endMin<=startMin)endMin=Math.min(24*60,startMin+minMinutes)}else{if(localDate<startDate||localDate>endDate)return null;if(localDate===startDate){endMin=24*60}else if(localDate===endDate){startMin=0}else{startMin=0;endMin=24*60}}startMin=clampMinutes(startMin);endMin=clampMinutes(endMin);if(endMin<=startMin)endMin=Math.min(24*60,startMin+minMinutes);const startPct=(startMin/(24*60))*100;const endPct=(endMin/(24*60))*100;if(!Number.isFinite(startPct)||!Number.isFinite(endPct))return null;return{status:event.status,startPct,endPct}}).filter((range):range is {status:NormalizedEvent['status'];startPct:number;endPct:number}=>Boolean(range))}
      const dayTimelineProgressPct=(date:string)=>{const today=localYmd(new Date());const target=localYmd(date);if(target<today)return 100;if(target>today)return 0;const now=new Date();const mins=now.getHours()*60+now.getMinutes()+now.getSeconds()/60;return Math.max(0,Math.min(100,(mins/(24*60))*100))}

      let activeWrap:HTMLElement|null=null
      let activeBtn:HTMLButtonElement|null=null
      let lockOpen=false
      const hideTimers=new WeakMap<HTMLElement,number>()
      let nowTicker:number|null=null

      let lastSyncedAt:string|null=null
      let eventsVersionKey:string|null=null
      let eventsFreshnessTicker:number|null=null
      let relativeTimeTicker:number|null=null
      let activeBadge:HTMLElement|null=null
      let badgeLockOpen=false

      const renderEventsFreshness=()=>{if(!eventsFreshness)return;const overview=document.querySelector<HTMLElement>('.status-overview');if(!lastSyncedAt){eventsFreshness.hidden=false;eventsFreshness.classList.add('is-stale');eventsFreshness.classList.remove('is-fresh');eventsFreshness.textContent='Status unknown';overview?.classList.add('has-stale-data');return}const syncedMs=new Date(lastSyncedAt).getTime();const delayed=!Number.isFinite(syncedMs)||Date.now()-syncedMs>EVENTS_DELAY_MS;eventsFreshness.hidden=false;eventsFreshness.classList.toggle('is-stale',delayed);eventsFreshness.classList.toggle('is-fresh',!delayed);eventsFreshness.textContent=delayed?`Delayed · ${rel(lastSyncedAt)}`:`Synced · ${rel(lastSyncedAt)}`;overview?.classList.toggle('has-stale-data',delayed)}

      const setEventsFreshness=(syncedAt:string|null)=>{lastSyncedAt=syncedAt;renderEventsFreshness();if(eventsFreshnessTicker){window.clearInterval(eventsFreshnessTicker);eventsFreshnessTicker=null}if(lastSyncedAt){eventsFreshnessTicker=window.setInterval(renderEventsFreshness,1000)}}

