---
import Nav from '../components/Nav.astro'

type Check = {
  token: string
  url: string
  alias?: string
  enabled: boolean
  published: boolean
  down: boolean
  uptime: number
  last_check_at: string
  displayName?: string
  periodUptime?: number
  history?: DayHistory[]
}

type DayHistory = {
  date: string
  hadDowntime: boolean
  downtimeSeconds: number
  partial: boolean
  utcWindows: string[]
}


type StatusEventType = 'maintenance_started' | 'maintenance_ended' | 'incident_started' | 'incident_resolved' | 'state_changed'
type StatusEvent = { token: string; alias: string; from: string; to: string; type: StatusEventType; at: string }
type MarkerStatus = 'operational' | 'maintenance' | 'degraded' | 'outage'
type NormalizedEvent = {
  id: string
  serviceId: string
  date: string
  startAt?: string
  endAt?: string
  status: Exclude<MarkerStatus, 'operational'>
  title: string
  description?: string
  ongoing: boolean
}

type DayPayload = {
  date: string
  marker: MarkerStatus
  count: number
  events: NormalizedEvent[]
}


const dayKey = (value: Date | string) => new Date(value).toISOString().slice(0, 10)
const ledHash = (token: string) => {
  let hash = 0
  for (const ch of token) hash = (hash * 33 + ch.charCodeAt(0)) >>> 0
  return hash
}
const ledPhaseMs = (token: string) => -(ledHash(token) % 1200)
const ledDurationMs=(token:string)=>180+(ledHash(token)%121)



const statusFromDowntime = (seconds: number): 'degraded' | 'outage' => (seconds >= 15 * 60 ? 'outage' : 'degraded')





const eventsByToken: Record<string, StatusEvent[]> = {}

const parseUtcWindow = (window: string) => {
  const [startRaw, endRaw] = window.split(' → ')
  if (!startRaw || !endRaw) return null
  const toIso = (v: string) => v.replace(' UTC', '').replace(' ', 'T')
  return { startAt: toIso(startRaw), endAt: toIso(endRaw) }
}

const eventsForDay = (serviceId: string, date: string, dayHistory: DayHistory): NormalizedEvent[] => {
  const out: NormalizedEvent[] = []

  if (dayHistory.downtimeSeconds > 0) {
    const status = statusFromDowntime(dayHistory.downtimeSeconds)
    const windows = dayHistory.utcWindows.slice(0, 3)
    if (windows.length > 0) {
      windows.forEach((w, idx) => {
        const parsed = parseUtcWindow(w)
        out.push({
          id: `${serviceId}-${date}-downtime-${idx}`,
          serviceId,
          date,
          startAt: parsed?.startAt,
          endAt: parsed?.endAt,
          status,
          title: status === 'outage' ? 'Service Unavailable' : 'Service Degradation',
          ongoing: false,
        })
      })
    } else {
      out.push({
        id: `${serviceId}-${date}-downtime`,
        serviceId,
        date,
        status,
        title: status === 'outage' ? 'Service Unavailable' : 'Service Degradation',
        ongoing: false,
      })
    }
  }

  const sameDay = (eventsByToken[serviceId] ?? []).filter((event) => dayKey(event.at) === date)
  let maintenanceStart: StatusEvent | null = null
  for (const e of sameDay) {
    if (e.type === 'maintenance_started') {
      maintenanceStart = e
      continue
    }
    if (e.type === 'maintenance_ended') {
      out.push({
        id: `${serviceId}-${e.at}-maintenance`,
        serviceId,
        date,
        startAt: maintenanceStart?.at,
        endAt: e.at,
        status: 'maintenance',
        title: 'Scheduled Maintenance',
        ongoing: false,
      })
      maintenanceStart = null
    }
  }
  if (maintenanceStart) {
    out.push({
      id: `${serviceId}-${maintenanceStart.at}-maintenance-ongoing`,
      serviceId,
      date,
      startAt: maintenanceStart.at,
      status: 'maintenance',
      title: 'Scheduled Maintenance',
      ongoing: true,
    })
  }

  return out.sort((a, b) => new Date(a.startAt ?? a.endAt ?? 0).getTime() - new Date(b.startAt ?? b.endAt ?? 0).getTime())
}

const markerFromEvents = (events: NormalizedEvent[]): MarkerStatus => {
  if (events.some((e) => e.status === 'outage')) return 'outage'
  if (events.some((e) => e.status === 'degraded')) return 'degraded'
  if (events.some((e) => e.status === 'maintenance')) return 'maintenance'
  return 'operational'
}

const checks: Check[] = []

const now = new Date()
const fmt = (n: number) => (Number.isFinite(n) ? `${n.toFixed(n === 100 ? 0 : 2)}%` : '—')
const dateFmt = (s: string) => new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' }).format(new Date(s))
