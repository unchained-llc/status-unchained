---
type Check={token:string;url:string;alias?:string;enabled:boolean;published:boolean;down:boolean;uptime:number;last_check_at:string;displayName?:string;periodUptime?:number;history?:{date:string;hadDowntime:boolean}[]};
type Downtime={started_at:string;ended_at:string|null};
const apiKey='ro-REDACTED';
const days=Array.from({length:7},(_,i)=>{const d=new Date();d.setUTCHours(0,0,0,0);d.setUTCDate(d.getUTCDate()-(6-i));return d});
const sevenDaysAgo=new Date(Date.now()-7*24*60*60*1000);const periodUptime=async(token:string)=>{try{const url=`https://updown.io/api/checks/${token}/metrics?api-key=${apiKey}&from=${encodeURIComponent(sevenDaysAgo.toISOString())}&to=${encodeURIComponent(new Date().toISOString())}`;const r=await fetch(url);if(!r.ok)return NaN;const metrics=await r.json() as {uptime:number};return Number(metrics.uptime)}catch{return NaN}};const history=async(token:string)=>{try{const r=await fetch(`https://updown.io/api/checks/${token}/downtimes?api-key=${apiKey}`);const ds=await r.json() as Downtime[];return days.map(date=>{const end=new Date(date);end.setUTCDate(end.getUTCDate()+1);return{date:date.toISOString(),hadDowntime:ds.some(x=>new Date(x.started_at)<end&&new Date(x.ended_at??Date.now())>=date)}})}catch{return days.map(date=>({date:date.toISOString(),hadDowntime:false}))}};
let checks:Check[]=[];
try{const response=await fetch(`https://updown.io/api/checks?api-key=${apiKey}`);const data=await response.json() as Check[];const sorted=[...data].sort((a,b)=>(a.alias?.trim()||`Check ${a.token}`).localeCompare(b.alias?.trim()||`Check ${b.token}`,'en'));checks=await Promise.all(sorted.map(async c=>({...c,displayName:c.alias?.trim()||`Check ${c.token}`,periodUptime:await periodUptime(c.token),history:await history(c.token)})))}catch{checks=[]}
const now=new Date();const fmt=(n:number)=>Number.isFinite(n)?`${n.toFixed(n===100?0:2)}%`:'—';const dateFmt=(s:string)=>new Intl.DateTimeFormat('en',{month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(s));
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="color-scheme" content="light dark"/><meta name="description" content="UNCHAINEDが提供するサービスの稼働状況"/><title>UNCHAINED | Service Status</title><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260202"/><link rel="icon" type="image/png" href="/favicon.png?v=20260202"/><link rel="stylesheet" href="/global.css?v=20260728"/><noscript><style>.services{opacity:1!important}</style></noscript><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@100;200;300;400;500;600&display=swap" rel="stylesheet"/></head><body><div class="page-shell"><header class="site-header"><a href="https://www.unchained.co.jp" class="brand" aria-label="UNCHAINED公式サイト"><img src="/assets/logo.svg" alt="" width="48" height="48"/><span>UNCHAINED</span></a></header><main class="status-page" data-api-key={apiKey}><header class="page-heading"><p class="kicker">STATUS</p><h1 class="bilingual-title"><span class="en">Service Status</span><span class="ja">サービス稼働状況</span></h1></header><section class="status-overview is-checking" aria-live="polite"><span class="overview-dot"></span><div><p class="overview-primary">Checking systems</p><p class="overview-secondary">現在の稼働状況を確認しています</p></div><div class="overview-meta"><span class="status-count">Checking current status</span><time class="last-updated" datetime={now.toISOString()}>Live status</time></div></section><section class="services is-initializing" aria-busy="true">{checks.map(c=><article class:list={['service-row',c.down?'is-down':!c.enabled?'is-maintenance':'is-up']} data-token={c.token}><div class="service-identity"><span class="service-dot"></span><div><h2>{c.displayName}</h2><p>Last checked <time datetime={c.last_check_at}>{c.last_check_at}</time></p><div class="history">{c.history?.map(d=><span class:list={['history-day',d.hadDowntime&&'had-downtime']} title={`${d.date.slice(0,10)}: ${d.hadDowntime?'Downtime recorded':'Operational'}`}></span>)}</div>{c.history&&<div class="history-labels"><span>{dateFmt(c.history[0].date)}</span><span>Today</span></div>}</div></div><div class="service-result"><span class="status-label">{c.down?'Disruption':!c.enabled?'Maintenance':'Operational'}</span><span class="uptime"><small>7-DAY UPTIME</small>{fmt(Number(c.periodUptime))}</span><a href={`https://updown.io/${c.token}`} target="_blank" rel="noreferrer">↗</a></div></article>)}{checks.length===0&&<div class="empty-state">現在公開中のサービス情報はありません</div>}</section><p class="status-note">Status monitoring by <a href="https://updown.io" target="_blank" rel="noreferrer">updown.io ↗</a></p></main><footer><p>&copy; {now.getFullYear()} UNCHAINED</p></footer></div><script>
type Check={token:string;alias?:string;enabled:boolean;down:boolean;uptime:number;last_check_at:string};
type Downtime={started_at:string;ended_at:string|null};
const page=document.querySelector<HTMLElement>('.status-page');
const services=document.querySelector<HTMLElement>('.services');
const rel=(value:string|Date)=>{const date=value instanceof Date?value:new Date(value);const seconds=Math.round((date.getTime()-Date.now())/1000);const formatter=new Intl.RelativeTimeFormat('en',{numeric:'auto'});const units:Array<[Intl.RelativeTimeFormatUnit,number]>=[['year',31536000],['month',2592000],['day',86400],['hour',3600],['minute',60],['second',1]];const[unit,amount]=units.find(([,amount])=>Math.abs(seconds)>=amount)??units.at(-1)!;return formatter.format(Math.round(seconds/amount),unit)};
const formatUptime=(value:number)=>Number.isFinite(value)?`${value.toFixed(value===100?0:2)}%`:'—';
const createRow=(check:Check)=>{const row=document.createElement('article');row.className='service-row';row.dataset.token=check.token;row.innerHTML=`<div class="service-identity"><span class="service-dot"></span><div><h2></h2><p>Last checked <time></time></p><div class="history"></div><div class="history-labels"><span></span><span>Today</span></div></div></div><div class="service-result"><span class="status-label"></span><span class="uptime"><small>7-DAY UPTIME</small>—</span><a target="_blank" rel="noreferrer">↗</a></div>`;row.querySelector<HTMLAnchorElement>('.service-result a')!.href=`https://updown.io/${check.token}`;return row};
const updateHistory=async(row:HTMLElement,check:Check,key:string)=>{try{const response=await fetch(`https://updown.io/api/checks/${check.token}/downtimes?api-key=${key}`);const downtimes=await response.json() as Downtime[];const dates=Array.from({length:7},(_,index)=>{const date=new Date();date.setUTCHours(0,0,0,0);date.setUTCDate(date.getUTCDate()-(6-index));return date});const history=row.querySelector<HTMLElement>('.history')!;history.replaceChildren(...dates.map(date=>{const end=new Date(date);end.setUTCDate(end.getUTCDate()+1);const hadDowntime=downtimes.some(item=>new Date(item.started_at)<end&&new Date(item.ended_at??Date.now())>=date);const bar=document.createElement('span');bar.className=`history-day${hadDowntime?' had-downtime':''}`;bar.title=`${date.toISOString().slice(0,10)}: ${hadDowntime?'Downtime recorded':'Operational'}`;return bar}));row.querySelector<HTMLElement>('.history-labels span')!.textContent=new Intl.DateTimeFormat('en',{month:'short',day:'numeric',timeZone:'UTC'}).format(dates[0])}catch{}}
const updateRow=async(check:Check,key:string)=>{if(!services)return;let row=document.querySelector<HTMLElement>(`[data-token="${check.token}"]`);const isNew=!row;if(!row)row=createRow(check);services.append(row);row.classList.toggle('is-down',check.down);row.classList.toggle('is-maintenance',!check.enabled);row.classList.toggle('is-up',!check.down&&check.enabled);row.querySelector<HTMLElement>('.service-identity h2')!.textContent=check.alias?.trim()||`Check ${check.token}`;row.querySelector<HTMLElement>('.status-label')!.textContent=check.down?'Disruption':!check.enabled?'Maintenance':'Operational';const time=row.querySelector<HTMLTimeElement>('.service-identity time')!;time.dateTime=check.last_check_at;time.textContent=rel(check.last_check_at);try{const from=new Date(Date.now()-7*24*60*60*1000).toISOString();const response=await fetch(`https://updown.io/api/checks/${check.token}/metrics?api-key=${key}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(new Date().toISOString())}`);const metrics=await response.json() as {uptime:number};row.querySelector<HTMLElement>('.uptime')!.lastChild!.textContent=formatUptime(Number(metrics.uptime))}catch{row.querySelector<HTMLElement>('.uptime')!.lastChild!.textContent='—'}if(isNew)await updateHistory(row,check,key)};
document.querySelectorAll<HTMLTimeElement>('.service-identity time').forEach(time=>time.textContent=rel(time.dateTime));
(async()=>{if(!page||!services)return;try{const key=encodeURIComponent(page.dataset.apiKey??'');const response=await fetch(`https://updown.io/api/checks?api-key=${key}`);const data=await response.json() as Check[];const checks=[...data].sort((a,b)=>(a.alias?.trim()||`Check ${a.token}`).localeCompare(b.alias?.trim()||`Check ${b.token}`,'en'));const tokens=new Set(checks.map(check=>check.token));services.querySelectorAll<HTMLElement>('.service-row').forEach(row=>{if(!tokens.has(row.dataset.token??''))row.remove()});const hasNew=checks.some(check=>!document.querySelector(`[data-token="${check.token}"]`));if(hasNew){services.classList.add('is-refreshing');services.setAttribute('aria-busy','true')}await Promise.all(checks.map(check=>updateRow(check,key)));services.classList.remove('is-initializing','is-refreshing');services.removeAttribute('aria-busy');const down=checks.some(check=>check.down);const disruptionCount=checks.filter(check=>check.down).length;const maintenanceCount=checks.filter(check=>!check.down&&!check.enabled).length;const operationalCount=checks.length-disruptionCount-maintenanceCount;const countText=disruptionCount||maintenanceCount?[`${operationalCount} Operational`,disruptionCount&&`${disruptionCount} Disruption`,maintenanceCount&&`${maintenanceCount} Maintenance`].filter(Boolean).join(' · '):`${operationalCount} / ${checks.length} Operational`;document.querySelector<HTMLElement>('.status-count')!.textContent=countText;const maintenance=maintenanceCount>0;const overview=document.querySelector<HTMLElement>('.status-overview')!;overview.classList.remove('is-checking','is-operational','has-incident','is-maintenance','is-error');overview.classList.add(down?'has-incident':maintenance?'is-maintenance':'is-operational');document.querySelector<HTMLElement>('.overview-primary')!.textContent=down?'Service disruption detected':maintenance?'Scheduled maintenance':'All systems operational';document.querySelector<HTMLElement>('.overview-secondary')!.textContent=down?'一部のサービスで障害が発生しています':maintenance?'一部のサービスはメンテナンス中です':'すべてのサービスは正常に稼働しています';const updated=document.querySelector<HTMLTimeElement>('.last-updated')!;updated.dateTime=new Date().toISOString();updated.textContent=`Updated ${rel(new Date())}`}catch(error){console.error(error);services?.classList.remove('is-initializing','is-refreshing');services?.removeAttribute('aria-busy');const overview=document.querySelector<HTMLElement>('.status-overview');overview?.classList.remove('is-checking');overview?.classList.add('is-error');document.querySelector<HTMLElement>('.overview-primary')!.textContent='Status unavailable';document.querySelector<HTMLElement>('.overview-secondary')!.textContent='稼働状況を取得できませんでした';document.querySelector<HTMLElement>('.status-count')!.textContent='Unable to update'}})();
</script></body></html>
